<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- الخادم الوسيط (محلي في المعمل كخدمة Windows، أو سحابي): صندوق بريد بين هواتف المندوبين وخدمة المزامنة. لا حسابات ولا قيود فيه. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ERP.Cloud.Contracts\ERP.Cloud.Contracts.csproj" />
  </ItemGroup>

  <!-- صفحة لوحة المدير (PWA) مضمّنة في البرنامج: لا ملفات منفصلة تُنسخ ولا مسار يُضبط -->
  <ItemGroup>
    <EmbeddedResource Include="Manager\**" LogicalName="Manager/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ERP.Cloud.Tests" />
  </ItemGroup>

</Project>
