<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- لوحة الألوان الموحّدة للنظام. ألوان المظهر (الأساسي، القائمة، الخلفية) يستبدلها المظهر المختار لكل مستخدم
         وقت التشغيل (ThemeApplier)، وتُستعمل بـ DynamicResource حتى تتغير فورًا. القيم هنا: مظهر «الرحمة» الافتراضي. -->
    <Color x:Key="PrimaryColor">#46546F</Color>
    <Color x:Key="SidebarColor">#2B3446</Color>
    <Color x:Key="SidebarHoverColor">#36415A</Color>
    <Color x:Key="BackgroundColor">#F3F5F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="MutedTextColor">#64748B</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="WarningColor">#D97706</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>
    <!-- أشرطة أسفل القائمة (المستخدم والجرس والمزامنة)، والعنصر المختار، وشارة العدد -->
    <SolidColorBrush x:Key="SidebarDeepBrush" Color="#222A39"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#3F4C66"/>
    <SolidColorBrush x:Key="SidebarChipBrush" Color="#36415A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6B7FA8"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
</ResourceDictionary>
