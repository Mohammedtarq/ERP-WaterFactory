<UserControl x:Class="ERP.Desktop.Views.Settings.BrandingSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Settings;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BrandingSectionViewModel}"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="بيانات الشركة على كل مستند مطبوع" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Text="تُدخل مرة واحدة وتظهر تلقائيًا في ترويسة وتذييل الفواتير والسندات والقيود والتقارير وكشوف الرواتب وشهادات المختبر."/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="اسم الشركة (عربي)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NameAr, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="اسم الشركة (إنجليزي — اختياري)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NameEn, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="أرقام الهاتف" Style="{StaticResource FieldLabel}"/>
                    <ItemsControl ItemsSource="{Binding Phones}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Left" Content="&#xE74D;" ToolTip="حذف الرقم" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                            Command="{Binding DataContext.RemovePhoneCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Command="{Binding AddPhoneCommand}" Content="إضافة رقم" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                    </DockPanel>
                    <TextBlock Text="العنوان الكامل" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="الرقم الضريبي (إن وُجد)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="رقم السجل التجاري (إن وُجد)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CommercialRegister, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="نص التذييل (مثل: شكرًا لتعاملكم معنا، أو شروط الدفع)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FooterText, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                <TextBlock Text="حفظ الهوية"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding PreviewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                <TextBlock Text="معاينة مستند نموذجي"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="الشعار" Style="{StaticResource SectionTitle}"/>
                        <Border Height="120" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Image Source="{Binding Logo, Converter={StaticResource BytesToImage}}" Stretch="Uniform" Margin="10"/>
                                <TextBlock Text="لا يوجد شعار" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasLogo, Converter={StaticResource InverseBoolToVisibility}}"/>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="PNG أو JPG حتى 2 ميغابايت، ويفضّل بخلفية شفافة."/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ChooseLogoCommand}" Content="اختيار صورة"/>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding RemoveLogoCommand}" Content="إزالة"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="لون العلامة" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                                   Text="يُستخدم فقط في الخط الفاصل ورأس الجدول والإجمالي النهائي — باقي الصفحة أسود على أبيض لتوفير الحبر."/>
                        <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="34" Height="34" Margin="0,0,6,6" ToolTip="{Binding Name}" Cursor="Hand"
                                            Command="{Binding DataContext.PickColorCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="17" Background="{Binding Hex, Converter={StaticResource HexBrush}}" BorderBrush="White" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,6,0,0">
                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="6" Margin="8,0,0,0"
                                    Background="{Binding BrandColor, Converter={StaticResource HexBrush}}"/>
                            <TextBox Text="{Binding BrandColor, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
