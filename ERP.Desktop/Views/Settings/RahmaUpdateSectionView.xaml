<UserControl x:Class="ERP.Desktop.Views.Settings.RahmaUpdateSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Settings;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RahmaUpdateSectionViewModel}"
             x:Name="Root">
    <!-- الصفحة تُمرَّر عموديًا كي يبقى جدول التقرير بارتفاع مريح مهما صغرت الشاشة -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0) استعادة نسخة الرحمة (.bak) كقاعدة منفصلة -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="١) استعادة نسخة الرحمة" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="اختر ملف النسخة الاحتياطية من نظام الرحمة (.bak). يُستعاد كقاعدة منفصلة جديدة ولا يمسّ قاعدة النظام. الملف يجب أن يكون على جهاز السيرفر نفسه (SQL Server هو الذي يقرأه): افتح البرنامج على السيرفر أو انسخ الملف إليه واكتب مساره هناك."/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SuccessButton}" Content="استعادة" Command="{Binding RestoreCommand}" Margin="8,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="اختيار ملف..." Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
                    <TextBox Text="{Binding RestoreFile, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="مسار ملف .bak على جهاز السيرفر"/>
                </DockPanel>
                <TextBlock Text="{Binding RestoreMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 1) المصدر والفحص والاعتماد -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="٢) فحص الفروق وتحديث البيانات" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="يُحدَّث العملاء والموردون وأسعار المنتجات من نسخة قاعدة الرحمة: الجديد يُضاف والمتغيّر يُحدَّث ولا يتكرر شيء. الأرصدة (المخزون والذمم والصناديق) لا يغيّرها هذا التحديث. قراءة فقط من قاعدة الرحمة."/>
                <WrapPanel>
                    <StackPanel Width="300" Margin="0,0,12,0">
                        <TextBlock Text="قاعدة الرحمة على هذا السيرفر" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Source}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                        <Run Text="{Binding LastActivity, Mode=OneWay, StringFormat='  — آخر حركة {0:yyyy/MM/dd}'}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="فحص الفروق" Command="{Binding PreviewCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SuccessButton}" Content="اعتماد التحديث" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" VerticalAlignment="Bottom" Margin="0,0,12,0"/>
                    <CheckBox Content="بلا نسخة احتياطية قبل التحديث (غير مستحسن)" IsChecked="{Binding SkipBackup}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock Text="{Binding SourceMessage}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PreviewText}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 2) التقرير -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
            <DockPanel>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Summary}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="12,6" Margin="0,0,8,6">
                                <TextBlock FontSize="13">
                                    <Run Text="{Binding Section, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text="{Binding New, Mode=OneWay, StringFormat='  جديد {0}'}" Foreground="#047857"/>
                                    <Run Text="{Binding Changed, Mode=OneWay, StringFormat='  · سيتغير {0}'}" Foreground="#B45309"/>
                                    <Run Text="{Binding Same, Mode=OneWay, StringFormat='  · بلا تغيير {0}'}" Foreground="#64748B"/>
                                    <Run Text="{Binding Skipped, Mode=OneWay, StringFormat='  · يُتخطّى {0}'}" Foreground="#64748B"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Notes}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" Height="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="النوع" Binding="{Binding Section}" Width="130"/>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="220"/>
                        <DataGridTemplateColumn Header="الحالة" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding ActionText}" Foreground="{Binding ActionColor}" FontWeight="Bold" Margin="6,0"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 3) آخر تحديث والتراجع وسجل التحديثات -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="سجل التحديثات والتراجع" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding LastRunText}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVisibility}}"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                    <TextBox Text="{Binding UndoReason, UpdateSourceTrigger=PropertyChanged}" Width="320" ToolTip="سبب التراجع (إلزامي)" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource DangerButton}" Content="التراجع عن آخر تحديث" Command="{Binding UndoCommand}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding History}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="130">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding When}" Width="140"/>
                        <DataGridTextColumn Header="المصدر" Binding="{Binding Source}" Width="160"/>
                        <DataGridTextColumn Header="الملخص" Binding="{Binding Summary}" Width="*"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding State}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
