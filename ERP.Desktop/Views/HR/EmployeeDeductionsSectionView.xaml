<UserControl x:Class="ERP.Desktop.Views.HR.EmployeeDeductionsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.HR;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:EmployeeDeductionsSectionViewModel}"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- تسجيل جديد -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="تسجيل جديد" Style="{StaticResource SectionTitle}"/>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SaveLabel}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="النوع" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" DisplayMemberPath="Label"/>
                        <Border Background="#FFFBEB" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                            <TextBlock Text="{Binding KindHint}" Foreground="#92400E" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                        <TextBlock Text="الموظف" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding Employee}" DisplayMemberPath="FullName" IsTextSearchEnabled="True"/>
                        <TextBlock Text="المبلغ (د.ع)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                        <StackPanel Visibility="{Binding IsLoan, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="القسط الشهري (د.ع)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Installment, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                            <TextBlock Text="{Binding InstallmentsText}" Style="{StaticResource Muted}" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StartLabel}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding StartMonth}" Width="70" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding StartYear}" Width="90"/>
                        </StackPanel>
                        <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding Date}"/>
                        <TextBlock Text="السبب / الملاحظة (إلزامي للعقوبة)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Reason}" TextWrapping="Wrap" MinHeight="50" AcceptsReturn="True"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- السجل -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="&#xE72C;" ToolTip="تحديث" Style="{StaticResource RowIconButton}" Tag="#0F766E" Command="{Binding RefreshCommand}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الموظف:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding FilterEmployee}" DisplayMemberPath="FullName" Width="220" IsTextSearchEnabled="True"/>
                        <CheckBox Content="غير المُستقطع بالكامل فقط" IsChecked="{Binding OpenOnly}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding TotalRemaining, StringFormat='إجمالي المتبقي للاستقطاع: {0:N0} د.ع'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border DockPanel.Dock="Bottom" Background="#FEF2F2" CornerRadius="8" Padding="12,10" Margin="0,10,0,0"
                        Visibility="{Binding IsVoiding, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding VoidTarget.DeductionNumber, StringFormat='إلغاء {0} (للأدمن) — سبب الإلغاء:'}" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding VoidReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource DangerButton}" Content="تأكيد الإلغاء" Command="{Binding VoidCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="تراجع" Command="{Binding CancelVoidCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="ToolTip" Value="{Binding VoidReason}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding DeductionNumber}" Width="125" MinWidth="110"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding EntryDate, StringFormat=yyyy/MM/dd}" Width="90"/>
                        <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="*" MinWidth="130"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding KindText}" Width="70"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="90"/>
                        <DataGridTextColumn Header="القسط" Binding="{Binding MonthlyInstallment, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="من شهر" Binding="{Binding StartPeriod}" Width="75"/>
                        <DataGridTextColumn Header="استُقطع" Binding="{Binding Deducted, StringFormat=N0}" Width="85"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding Remaining, StringFormat=N0}" Width="85"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="110"/>
                        <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="140"/>
                        <DataGridTemplateColumn Header="" Width="84">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="&#xE749;" ToolTip="طباعة" Style="{StaticResource RowIconButton}" Tag="#0F766E"
                                                Command="{Binding DataContext.PrintCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                        <Button Content="&#xE711;" ToolTip="إلغاء (للأدمن)" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                                Command="{Binding DataContext.BeginVoidCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
