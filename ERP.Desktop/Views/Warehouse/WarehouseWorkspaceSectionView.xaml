<UserControl x:Class="ERP.Desktop.Views.Warehouse.WarehouseWorkspaceSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Warehouse;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:WarehouseWorkspaceSectionViewModel}"
             x:Name="Root">
    <DockPanel>
        <!-- ================= رأس المخزن ومؤشراته ================= -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="10" Background="{Binding Color, Converter={StaticResource HexBrushSoft}}">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="22" Foreground="{Binding Color, Converter={StaticResource HexBrush}}"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="{Binding WarehouseTypeLabel}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="عدد الأصناف" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ItemsCount}" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="إجمالي القطع" Style="{StaticResource Muted}"/><TextBlock Text="{Binding TotalPieces, StringFormat=N0}" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="وارد اليوم" Style="{StaticResource Muted}"/><TextBlock Text="{Binding TodayIn, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="صادر اليوم" Style="{StaticResource Muted}"/><TextBlock Text="{Binding TodayOut, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/></StackPanel>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel><TextBlock Text="عند حد التنبيه" Style="{StaticResource Muted}"/><TextBlock Text="{Binding LowCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/></StackPanel>
            </Border>
        </Grid>

        <TabControl Background="Transparent" BorderThickness="0" Padding="0,8,0,0">
            <!-- ================= عملية جديدة ================= -->
            <TabItem Header="عملية جديدة">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="نوع العملية" Style="{StaticResource FieldLabel}" Margin="0"/>
                                <ComboBox ItemsSource="{Binding OperationOptions}" SelectedItem="{Binding Operation}" DisplayMemberPath="Label" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OperationHint}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding DocumentDate}"/>
                                <StackPanel Visibility="{Binding IsTransfer, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="المخزن المستلم" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding OtherWarehouses}" SelectedItem="{Binding CounterWarehouse}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding NeedsParty, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding PartyLabel}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox IsEditable="True" ItemsSource="{Binding PartySuggestions}" Text="{Binding PartyName, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="اختر جهة من القائمة الثابتة أو اكتب اسمًا جديدًا"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsDamaged, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="سبب التلف" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding ReasonOptions}" SelectedItem="{Binding DamageReason}" DisplayMemberPath="Label"/>
                                    <CheckBox Content="نقل الكمية التالفة إلى مخزن التالف" IsChecked="{Binding MoveToDamaged}"/>
                                </StackPanel>
                                <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True"/>
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Content="كل الأصناف" IsChecked="{Binding ShowAllItems}" Margin="0" FontSize="11"/>
                                            <TextBlock Text="الصنف" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        </DockPanel>
                                        <ComboBox ItemsSource="{Binding ItemsLookup}" SelectedItem="{Binding LineItem}" DisplayMemberPath="ItemName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="الوحدة" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding LineLevel}" DisplayMemberPath="LevelName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="التشغيلة" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding BatchOptions}" SelectedItem="{Binding LineBatch}" DisplayMemberPath="Label"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="الكمية" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                                    </StackPanel>
                                    <Button Grid.Column="8" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Command="{Binding AddLineCommand}" Margin="0" IsDefault="True">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                            <TextBlock Text="إضافة"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,8,0,0" Visibility="{Binding IsReceipt, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="رقم تشغيلة جديدة (اختياري)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding LineNewBatch, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="تاريخ الانتهاء" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding LineExpiry}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding LineAvailableText}" Style="{StaticResource Muted}" Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding LinePiecesText}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding SaveLabel}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}" Content="تفريغ"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LinesTotalText}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="True" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الرمز" Binding="{Binding ItemCode}" Width="95"/>
                                    <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="2*" MinWidth="130"/>
                                    <DataGridTextColumn Header="الوحدة" Binding="{Binding LevelName}" Width="60"/>
                                    <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityInLevel, StringFormat=N0}" Width="70"/>
                                    <DataGridTextColumn Header="بالقطعة" Binding="{Binding Pieces, StringFormat=N0}" Width="70"/>
                                    <DataGridTextColumn Header="التشغيلة" Binding="{Binding BatchLabel}" Width="1.6*" MinWidth="130"/>
                                    <DataGridTemplateColumn Header="" Width="46">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="&#xE74D;" ToolTip="حذف السطر" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                                        Command="{Binding DataContext.RemoveLineCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ================= الأرصدة ================= -->
            <TabItem Header="الأرصدة الحالية">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="&#xE72C;" ToolTip="تحديث" Style="{StaticResource RowIconButton}" Tag="#0F766E" Command="{Binding RefreshCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding PrintBalancesCommand}" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="طباعة الأرصدة"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="رصيد هذا المخزن وحده لكل صنف وتشغيلة" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Balances}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الكود" Binding="{Binding ItemCode}" Width="90"/>
                                <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="2*" MinWidth="140"/>
                                <DataGridTextColumn Header="التشغيلة" Binding="{Binding BatchNumber}" Width="130"/>
                                <DataGridTextColumn Header="المتغير" Binding="{Binding Variant, TargetNullValue='أساسي'}" Width="120"/>
                                <DataGridTextColumn Header="الصلاحية" Binding="{Binding ExpiryDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                                <DataGridTextColumn Header="الرصيد (قطعة)" Binding="{Binding Quantity, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="بوحدات التعبئة" Binding="{Binding Breakdown}" Width="*" MinWidth="110"/>
                                <DataGridCheckBoxColumn Header="حد التنبيه" Binding="{Binding BelowAlert, Mode=OneWay}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ================= التقارير ================= -->
            <TabItem Header="التقارير والمستندات">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker SelectedDate="{Binding ReportFrom}" Width="130"/>
                            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="12,0,6,0"/>
                            <DatePicker SelectedDate="{Binding ReportTo}" Width="130"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding LoadReportsCommand}" Margin="12,0,0,0" Content="عرض"/>
                        </StackPanel>
                    </Border>
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabItem Header="الرصيد والمتبقي (ملخص الحركة)">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Command="{Binding PrintSummaryCommand}" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                            <TextBlock Text="طباعة التقرير"/>
                                        </StackPanel>
                                    </Button>
                                    <DataGrid ItemsSource="{Binding Summary}" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="الكود" Binding="{Binding ItemCode}" Width="90"/>
                                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                                            <DataGridTextColumn Header="أول المدة" Binding="{Binding Opening, StringFormat=N0}" Width="95"/>
                                            <DataGridTextColumn Header="وارد" Binding="{Binding In, StringFormat=N0}" Width="90"/>
                                            <DataGridTextColumn Header="صادر" Binding="{Binding Out, StringFormat=N0}" Width="90"/>
                                            <DataGridTextColumn Header="تالف" Binding="{Binding Damaged, StringFormat=N0}" Width="80"/>
                                            <DataGridTextColumn Header="مجاني" Binding="{Binding Free, StringFormat=N0}" Width="80"/>
                                            <DataGridTextColumn Header="المتبقي" Binding="{Binding Closing, StringFormat=N0, Mode=OneWay}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </TabItem>
                        <TabItem Header="كشف الحركة التفصيلي">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Command="{Binding PrintLedgerCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                                <TextBlock Text="طباعة الكشف"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="الصنف:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox ItemsSource="{Binding LedgerItems}" SelectedItem="{Binding LedgerItem}" DisplayMemberPath="ItemName" Width="260"/>
                                            <Button Content="كل الأصناف" Style="{StaticResource SecondaryButton}" Command="{Binding AllItemsLedgerCommand}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataGrid ItemsSource="{Binding Ledger}" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='yyyy/MM/dd HH:mm'}" Width="125"/>
                                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                                            <DataGridTextColumn Header="الحركة" Binding="{Binding TypeLabel}" Width="150"/>
                                            <DataGridTextColumn Header="المستند" Binding="{Binding Reference}" Width="140"/>
                                            <DataGridTextColumn Header="التشغيلة" Binding="{Binding BatchNumber}" Width="100"/>
                                            <DataGridTextColumn Header="الجهة" Binding="{Binding Party}" Width="120"/>
                                            <DataGridTextColumn Header="وارد" Binding="{Binding In, StringFormat=N0}" Width="80"/>
                                            <DataGridTextColumn Header="صادر" Binding="{Binding Out, StringFormat=N0}" Width="80"/>
                                            <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N0}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </TabItem>
                        <TabItem Header="المستندات">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="النوع:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding DocumentFilters}" SelectedItem="{Binding DocumentFilter}" DisplayMemberPath="Label" Width="200"/>
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding Documents}" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="رقم المستند" Binding="{Binding DocumentNumber}" Width="140"/>
                                            <DataGridTextColumn Header="النوع" Binding="{Binding DocumentType, Converter={StaticResource EnumArabicConverter}}" Width="150"/>
                                            <DataGridTextColumn Header="التاريخ" Binding="{Binding DocumentDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                                            <DataGridTextColumn Header="مخزن المناقلة" Binding="{Binding CounterWarehouse}" Width="140"/>
                                            <DataGridTextColumn Header="الجهة" Binding="{Binding PartyName}" Width="*"/>
                                            <DataGridTextColumn Header="السطور" Binding="{Binding LinesCount}" Width="60"/>
                                            <DataGridTextColumn Header="القطع" Binding="{Binding TotalPieces, StringFormat=N0}" Width="90"/>
                                            <DataGridTextColumn Header="المستخدم" Binding="{Binding CreatedBy}" Width="100"/>
                                            <DataGridTemplateColumn Header="" Width="46">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="&#xE749;" ToolTip="طباعة المستند" Style="{StaticResource RowIconButton}" Tag="#0F766E"
                                                                Command="{Binding DataContext.PrintDocumentCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
