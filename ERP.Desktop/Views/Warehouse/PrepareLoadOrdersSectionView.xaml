<UserControl x:Class="ERP.Desktop.Views.Warehouse.PrepareLoadOrdersSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Warehouse;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PrepareLoadOrdersSectionViewModel}"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <!-- الطلبات -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="&#xE72C;" ToolTip="تحديث" Style="{StaticResource RowIconButton}" Tag="#2563EB" Command="{Binding RefreshCommand}"/>
                    <TextBlock Text="{Binding PendingCount, StringFormat='طلبات تحميل السيارات — بانتظار التجهيز: {0}'}" Style="{StaticResource SectionTitle}" Margin="0"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding OrderNumber}" Width="110"/>
                        <DataGridTextColumn Header="تاريخ التحميل" Binding="{Binding LoadDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                        <DataGridTextColumn Header="المندوب" Binding="{Binding RepName}" Width="*"/>
                        <DataGridTextColumn Header="السيارة" Binding="{Binding VanName}" Width="*"/>
                        <DataGridTextColumn Header="القطع" Binding="{Binding RequestedPieces, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="110"/>
                        <DataGridTextColumn Header="مستند الإسناد" Binding="{Binding DocumentNumber}" Width="130"/>
                        <DataGridTextColumn Header="طلبه" Binding="{Binding RequestedBy}" Width="90"/>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE749;" ToolTip="طباعة الطلب" Style="{StaticResource RowIconButton}" Tag="#0F766E"
                                            Command="{Binding DataContext.PrintCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- التجهيز -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="تجهيز الطلب المختار" Style="{StaticResource SectionTitle}"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="«المتاح» = رصيد الصنف في المخزن الآن. عدّل «المجهَّز» إن نقص صنف؛ عند التجهيز تخرج الكميات المجهَّزة فقط إلى سيارة المندوب بمستند إسناد مرقّم."/>
                <Button DockPanel.Dock="Bottom" Content="تجهيز وإخراج للسيارة" Style="{StaticResource SuccessButton}" Command="{Binding PrepareCommand}"
                        IsEnabled="{Binding CanPrepare}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <DataGrid ItemsSource="{Binding PrepareLines}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,6,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المتغير" Binding="{Binding VariantName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الوحدة" Binding="{Binding LevelName}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المطلوب" Binding="{Binding Requested, StringFormat=N0}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المتاح" Binding="{Binding AvailableText}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المجهَّز" Binding="{Binding Prepared, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridCheckBoxColumn Header="لا يكفي" Binding="{Binding IsShort, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
