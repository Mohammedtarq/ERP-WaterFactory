<UserControl x:Class="ERP.Desktop.Views.Shell.ModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Shell;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ModuleViewModel}"
             x:Name="Root">
    <DockPanel>
        <!-- عنوان الوحدة -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="تفريغ الشاشة" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCurrentCommand}"
                    ToolTip="يلغي ما أُدخل ولم يُحفظ ويعيد الشاشة كما فُتحت (تعود نظيفة تلقائيًا أيضًا عند الخروج منها)"
                    Visibility="{Binding CanClearCurrent, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Background="{Binding Color, Converter={StaticResource HexBrush}}">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="19" Foreground="White"/>
                </Border>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <!-- تثبيت الشاشة الظاهرة في «مفضلتي» -->
                <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding SelectedTab}"
                        Cursor="Hand" Margin="10,0,0,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="4">
                    <TextBlock FontSize="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="☆"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="ToolTip" Value="أضف هذه الشاشة إلى «مفضلتي»"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab.IsFavorite}" Value="True">
                                        <Setter Property="Text" Value="★"/>
                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                        <Setter Property="ToolTip" Value="في «مفضلتي» — اضغط للإزالة"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- المسار الحالي: المجموعة ‹ القسم. التنقل بين الأقسام من القائمة الجانبية (الرئيسية ثم المجموعات) -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding Breadcrumb}" Style="{StaticResource Muted}" FontSize="14" Margin="52,-6,0,12"/>

        <!-- المحتوى يُختار تلقائيًا حسب نوع القسم (ViewMappings.xaml) -->
        <ContentControl Content="{Binding SelectedTab}"/>
    </DockPanel>
</UserControl>
