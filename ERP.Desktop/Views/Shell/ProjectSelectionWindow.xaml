<Window x:Class="ERP.Desktop.Views.Shell.ProjectSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Shell;assembly=ERP.Presentation"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ProjectSelectionViewModel}"
        x:Name="Root"
        Title="اختيار المشروع — نظام إدارة الأعمال المتكامل"
        FlowDirection="RightToLeft" FontFamily="{StaticResource UiFont}"
        Width="660" Height="580" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel Margin="32">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="كل مشروع قاعدة بيانات مستقلة تمامًا. اختر المشروع الذي تريد العمل عليه." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- حذف مشروع: كتابة اسمه للتأكيد -->
        <Border DockPanel.Dock="Bottom" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0"
                Visibility="{Binding IsDeleting, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding DeletePrompt}" TextWrapping="Wrap" Foreground="#991B1B" FontWeight="SemiBold"/>
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource SecondaryButton}" Command="{Binding CancelDeleteCommand}"/>
                    <Button DockPanel.Dock="Left" Content="حذف نهائي" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="8,0"/>
                    <TextBox Text="{Binding DeleteConfirmText, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="فتح المشروع" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" IsDefault="True"/>
            <Button Content="رجوع لتسجيل الدخول" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding DataContext.OpenCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                        </Border.InputBindings>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="&#xE74D;" ToolTip="حذف المشروع وقاعدته (للمدير، بعد نسخة احتياطية)" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                    Command="{Binding DataContext.BeginDeleteCommand, ElementName=Root}" CommandParameter="{Binding}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#CCFBF1">
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProjectName}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DatabaseName}" Style="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
