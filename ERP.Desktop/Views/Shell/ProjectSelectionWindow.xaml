<Window x:Class="ERP.Desktop.Views.Shell.ProjectSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Shell;assembly=ERP.Presentation"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ProjectSelectionViewModel}"
        x:Name="Root"
        Title="اختيار المشروع — نظام إدارة الأعمال المتكامل"
        FlowDirection="RightToLeft" FontFamily="{StaticResource UiFont}"
        Width="640" Height="520" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel Margin="32">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="كل مشروع قاعدة بيانات مستقلة تمامًا. اختر المشروع الذي تريد العمل عليه." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="فتح المشروع" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" IsDefault="True"/>
            <Button Content="رجوع لتسجيل الدخول" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding DataContext.OpenCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="10" Background="#CCFBF1">
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProjectName}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DatabaseName}" Style="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
