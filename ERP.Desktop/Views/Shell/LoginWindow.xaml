<Window x:Class="ERP.Desktop.Views.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Shell;assembly=ERP.Presentation"
        xmlns:c="clr-namespace:ERP.Desktop.Views.Controls"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LoginViewModel}"
        Title="تسجيل الدخول — نظام إدارة الأعمال المتكامل"
        FlowDirection="RightToLeft" FontFamily="pack://application:,,,/ERP.Desktop;component/Assets/Fonts/#IBM Plex Sans Arabic"
        Width="1100" Height="720" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="White">
    <!-- التصميم المعتمد: جانب أبيض بمحتوى متوسّط (شعار، اسم المعمل، «تسجيل الدخول»، المستخدمون بصورهم، كلمة المرور، «دخول»)
         ولوحة زرقاء بشعار أبيض في وسطها. الكحلي #0F3556 لون موحّد للنصوص وزر الدخول. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= جانب الدخول (يمين) ================= -->
        <Grid Grid.Column="0" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
                    <!-- شعار المعمل (من «هوية الطباعة») وإلا الشعار الملوّن -->
                    <Grid HorizontalAlignment="Center" Height="76">
                        <Image Source="pack://application:,,,/ERP.Desktop;component/Assets/logo-color.png" Width="76" Height="76"
                               RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding CompanyLogo, Converter={StaticResource NullToVisible}}"/>
                        <Image Source="{Binding CompanyLogo, Converter={StaticResource BytesToImage}}" MaxWidth="160" MaxHeight="76" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding CompanyLogo, Converter={StaticResource NullToCollapsed}}"/>
                    </Grid>
                    <TextBlock Text="{Binding Title}" Foreground="#0F3556" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="تسجيل الدخول" Foreground="#0F3556" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="اختر حسابك ثم أدخل كلمة المرور" Foreground="#0F3556" Opacity="0.75" FontSize="14.5" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- المستخدمون بصورهم: المختار بحلقة -->
                    <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}" Margin="0,18,0,0">
                        <ListBox x:Name="UsersList" ItemsSource="{Binding Recent}" SelectedItem="{Binding PickedUser, Mode=TwoWay}" SelectionChanged="OnPickUser"
                             HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTip" Value="{Binding FullName}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <StackPanel Width="108" Margin="4,0" Background="Transparent">
                                                <Border x:Name="Ring" Width="82" Height="82" CornerRadius="41" BorderThickness="3" BorderBrush="Transparent" Padding="3" HorizontalAlignment="Center">
                                                    <c:Avatar Photo="{Binding Photo}" DisplayName="{Binding FullName}" Size="70"/>
                                                </Border>
                                                <TextBlock x:Name="Name" Text="{Binding Username}" Foreground="#0F3556" FontSize="13.5" FontWeight="SemiBold" TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding Role}" Foreground="#6B8296" FontSize="11.5" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="#CBD5E1"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="#2B8FD6"/>
                                                    <Setter TargetName="Name" Property="FontWeight" Value="Bold"/>
                                                    <Setter TargetName="Name" Property="Foreground" Value="#0F172A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0">
                        <!-- اسم المستخدم لمن ليس في الصور فقط -->
                        <Border CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1.5" Background="White" Padding="14,2" Margin="0,0,0,12"
                                Visibility="{Binding IsOtherUser, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="15" Foreground="#0F3556" VerticalAlignment="Center"/>
                                <Grid Margin="8,0,0,0">
                                    <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" BorderThickness="0"
                                             Background="Transparent" Foreground="#0F3556" FontSize="15" Padding="2,10"/>
                                    <TextBlock Text="اسم المستخدم" Foreground="#0F3556" Opacity="0.7" FontSize="14.5" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding Username, Converter={StaticResource NullToVisible}}"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- كلمة المرور بأيقونة القفل وزر الإظهار -->
                        <Border CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1.5" Background="White" Padding="14,2">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05" Color="#0F3556"/></Border.Effect>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="15" Foreground="#0F3556" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="ShowPassword" DockPanel.Dock="Right" Cursor="Hand" ToolTip="إظهار كلمة المرور" Checked="OnShowPassword" Unchecked="OnHidePassword"
                                              VerticalAlignment="Center">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="4"><ContentPresenter/></Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="16" Foreground="#0F3556"/>
                                </ToggleButton>
                                <Grid Margin="8,0,0,0">
                                    <PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight" BorderThickness="0" Background="Transparent" Foreground="#0F3556" FontSize="15" Padding="2,12"
                                                 PasswordChanged="OnPasswordChanged"/>
                                    <TextBox x:Name="PlainPassword" FlowDirection="LeftToRight" BorderThickness="0" Background="Transparent" Foreground="#0F3556" FontSize="15" Padding="2,12" Visibility="Collapsed"/>
                                    <TextBlock x:Name="PasswordHint" Text="{Binding PasswordHint}" Foreground="#0F3556" Opacity="0.7" FontSize="14.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Border Background="#FEF2F2" CornerRadius="8" Padding="10,8" Margin="0,12,0,0"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <Button IsDefault="True" Margin="0,16,0,0" Height="54" Cursor="Hand" Click="OnLoginClick"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="14" Background="#0F3556">
                                        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.28" Color="#0F3556"/></Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#16507F"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="دخول" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" Foreground="White" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="جارٍ التحقق..." Foreground="#0F3556" Opacity="0.75" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Command="{Binding OtherUserCommand}" Click="OnOtherUser" Cursor="Hand" HorizontalAlignment="Center" Margin="0,14,0,0"
                                Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="T" Text="مستخدم آخر…" Foreground="#0F3556" FontSize="13.5" FontWeight="SemiBold"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= اللوحة الزرقاء (يسار): شعار أبيض في الوسط ================= -->
        <Grid Grid.Column="1" ClipToBounds="True">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.85" RadiusY="0.85">
                    <GradientStop Color="#2A74AE" Offset="0"/>
                    <GradientStop Color="#1B4F7A" Offset="0.5"/>
                    <GradientStop Color="#0F3556" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60" IsHitTestVisible="False">
                <Ellipse Width="620" Height="620" Stroke="#338FD3F4" StrokeThickness="1.4"/>
                <Ellipse Width="460" Height="460" Stroke="#338FD3F4" StrokeThickness="1.4" Opacity="0.8"/>
                <Ellipse Width="320" Height="320" Stroke="#338FD3F4" StrokeThickness="1.4" Opacity="0.6"/>
                <!-- الشعار بقناع: صورة الشعار تتحول إلى ظل أبيض -->
                <Rectangle Width="240" Height="240" Fill="White" Opacity="0.93" Visibility="{Binding CompanyLogo, Converter={StaticResource NullToVisible}}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="pack://application:,,,/ERP.Desktop;component/Assets/logo-color.png" Stretch="Uniform"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Width="240" Height="240" Fill="White" Opacity="0.93" Visibility="{Binding CompanyLogo, Converter={StaticResource NullToCollapsed}}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding CompanyLogo, Converter={StaticResource BytesToImage}}" Stretch="Uniform"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,44">
                <TextBlock Text="تصميم حسابات المعمل" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="مخازن · إنتاج · مبيعات · مالية" Foreground="#CFE6F5" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
