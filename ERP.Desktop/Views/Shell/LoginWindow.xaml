<Window x:Class="ERP.Desktop.Views.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Shell;assembly=ERP.Presentation"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LoginViewModel}"
        Title="تسجيل الدخول — نظام إدارة الأعمال المتكامل"
        FlowDirection="RightToLeft" FontFamily="{StaticResource UiFont}"
        Width="880" Height="540" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=UserBox}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- لوحة الترحيب -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel VerticalAlignment="Center" Margin="48,0">
                <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="34" Foreground="White"/>
                </Border>
                <TextBlock Text="نظام إدارة الأعمال المتكامل" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,24,0,8"/>
                <TextBlock Text="المخازن · المبيعات · المشتريات · المالية" Foreground="#94A3B8" FontSize="15"/>
                <TextBlock Text="دخول موحّد لكل مشاريعك، وصلاحيات دقيقة لكل قسم." Foreground="#94A3B8" FontSize="13" Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- نموذج الدخول -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0">
            <TextBlock Text="تسجيل الدخول" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="أدخل بيانات حسابك للمتابعة" Style="{StaticResource Muted}" Margin="0,4,0,20"/>

            <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>

            <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight"/>

            <Border Background="#FEF2F2" CornerRadius="6" Padding="10,8" Margin="0,14,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <Button Content="دخول" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,20,0,0" Padding="14,10"
                    Click="OnLoginClick" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            <TextBlock Text="جارٍ التحقق..." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
    </Grid>
</Window>
