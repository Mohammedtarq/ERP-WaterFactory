<Window x:Class="ERP.Desktop.Views.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Shell;assembly=ERP.Presentation"
        xmlns:c="clr-namespace:ERP.Desktop.Views.Controls"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LoginViewModel}"
        Title="تسجيل الدخول — نظام إدارة الأعمال المتكامل"
        FlowDirection="RightToLeft" FontFamily="{StaticResource UiFont}"
        Width="1100" Height="720" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SidebarDeepBrush}">
    <!-- التصميم المعتمد: بطاقة بيضاء في الوسط على خلفية لون المظهر، فيها الشعار واسم المعمل وعبارته،
         ثم المستخدمون بدوائر صورهم، وكلمة المرور لمن اختير، و«مستخدم آخر…»، والمظهر أسفل الشاشة -->
    <Grid>
        <!-- خلفية: تدرج لون المظهر ودوائر خافتة -->
        <Border Background="{DynamicResource SidebarBrush}" Opacity="0.55">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>
        <Canvas ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse Width="560" Height="560" Canvas.Left="-160" Canvas.Top="-200" Stroke="#22FFFFFF" StrokeThickness="1.5"/>
            <Ellipse Width="760" Height="760" Canvas.Left="-260" Canvas.Top="160" Stroke="#18FFFFFF" StrokeThickness="1.5"/>
            <Ellipse Width="520" Height="520" Canvas.Right="-140" Canvas.Bottom="-180" Stroke="#22FFFFFF" StrokeThickness="1.5"/>
        </Canvas>

        <TextBlock Text="{Binding VersionText}" Foreground="#CBD5E1" FontSize="12.5" Margin="22,16" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- البطاقة -->
        <Border Background="White" CornerRadius="26" Width="660" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="44,30,44,26" Margin="0,0,0,40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#0B1A33"/>
            </Border.Effect>
            <StackPanel>
                <!-- شعار المعمل (من «هوية الطباعة») وإلا الشعار الملوّن -->
                <Grid HorizontalAlignment="Center" Height="110">
                    <Image Source="pack://application:,,,/Assets/logo-color.png" Width="110" Height="110"
                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding CompanyLogo, Converter={StaticResource NullToVisible}}"/>
                    <Image Source="{Binding CompanyLogo, Converter={StaticResource BytesToImage}}" MaxWidth="200" MaxHeight="110" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding CompanyLogo, Converter={StaticResource NullToCollapsed}}"/>
                </Grid>
                <TextBlock Text="{Binding Title}" Foreground="#1E293B" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="{Binding Slogan}" Foreground="#64748B" FontSize="15" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Visibility="{Binding Slogan, Converter={StaticResource NullToCollapsed}}"/>

                <!-- المستخدمون بصورهم: المختار بحلقة -->
                <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}" Margin="0,20,0,0">
                    <TextBlock Text="اختر المستخدم" Foreground="#475569" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ListBox x:Name="UsersList" ItemsSource="{Binding Recent}" SelectedItem="{Binding PickedUser, Mode=TwoWay}" SelectionChanged="OnPickUser"
                             HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTip" Value="{Binding Username}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <StackPanel Width="108" Margin="4,0" Background="Transparent">
                                                <Border x:Name="Ring" Width="82" Height="82" CornerRadius="41" BorderThickness="3" BorderBrush="Transparent" Padding="3" HorizontalAlignment="Center">
                                                    <c:Avatar Photo="{Binding Photo}" DisplayName="{Binding FullName}" Size="70"/>
                                                </Border>
                                                <TextBlock x:Name="Name" Text="{Binding FullName}" Foreground="#334155" FontSize="13.5" FontWeight="SemiBold" TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding Role}" Foreground="#94A3B8" FontSize="11.5" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="#CBD5E1"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource SidebarBrush}"/>
                                                    <Setter TargetName="Name" Property="FontWeight" Value="Bold"/>
                                                    <Setter TargetName="Name" Property="Foreground" Value="#0F172A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>

                <StackPanel Width="380" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <!-- اسم المستخدم لمن ليس في الصور فقط -->
                    <Border CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1.2" Padding="12,2" Margin="0,0,0,10"
                            Visibility="{Binding IsOtherUser, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Grid Margin="8,0,0,0">
                                <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" BorderThickness="0"
                                         Background="Transparent" FontSize="15" Padding="2,9"/>
                                <TextBlock Text="اسم المستخدم" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Username, Converter={StaticResource NullToVisible}}"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- كلمة المرور بأيقونة القفل وزر الإظهار -->
                    <Border CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1.2" Padding="12,2">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="ShowPassword" DockPanel.Dock="Right" Cursor="Hand" ToolTip="إظهار كلمة المرور" Checked="OnShowPassword" Unchecked="OnHidePassword"
                                          VerticalAlignment="Center">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="4"><ContentPresenter/></Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="16" Foreground="#64748B"/>
                            </ToggleButton>
                            <Grid Margin="8,0,0,0">
                                <PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight" BorderThickness="0" Background="Transparent" FontSize="15" Padding="2,9"
                                             PasswordChanged="OnPasswordChanged"/>
                                <TextBox x:Name="PlainPassword" FlowDirection="LeftToRight" BorderThickness="0" Background="Transparent" FontSize="15" Padding="2,9" Visibility="Collapsed"/>
                                <TextBlock x:Name="PasswordHint" Text="{Binding PasswordHint}" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Background="#FEF2F2" CornerRadius="8" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <Button IsDefault="True" Margin="0,16,0,0" Height="48" Cursor="Hand" Click="OnLoginClick"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="12" Background="{DynamicResource SidebarBrush}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="دخول" Foreground="White" FontSize="16.5" FontWeight="Bold"/>
                    </Button>
                    <TextBlock Text="جارٍ التحقق..." Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Command="{Binding OtherUserCommand}" Click="OnOtherUser" Cursor="Hand" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="T" Text="مستخدم آخر…" Foreground="#334155" FontSize="13.5" FontWeight="SemiBold"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- المظهر قبل الدخول: يُحفظ لهذا المستخدم بعد دخوله -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
            <TextBlock Text="المظهر" Foreground="#E2E8F0" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ListBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Ring" Width="30" Height="30" CornerRadius="15" BorderThickness="2" BorderBrush="Transparent" Margin="3,0" Padding="3">
                                        <Ellipse Fill="{Binding Primary, Converter={StaticResource HexBrush}}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="#94A3B8"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>
    </Grid>
</Window>
