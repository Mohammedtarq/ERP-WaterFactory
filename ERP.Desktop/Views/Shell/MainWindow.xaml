<Window x:Class="ERP.Desktop.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Shell;assembly=ERP.Presentation"
        xmlns:c="clr-namespace:ERP.Desktop.Views.Controls"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainShellViewModel}"
        x:Name="Root"
        Title="{Binding WindowTitle}"
        FlowDirection="RightToLeft" FontFamily="{StaticResource UiFont}" FontSize="14"
        Width="1400" Height="860" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource BackgroundBrush}">
    <Window.InputBindings>
        <!-- البحث السريع عن أي شاشة -->
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenSearchCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= أعلى اليسار: المزامنة · التنبيهات · صورة المستخدم · الخروج (متجاورة) ================= -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,10,22,0">
            <StackPanel.Resources>
                <Style x:Key="Pill" TargetType="Border">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="CornerRadius" Value="18"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                    <Setter Property="Effect">
                        <Setter.Value><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12"/></Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>

            <!-- المزامنة -->
            <Border Style="{StaticResource Pill}" ToolTip="{Binding CloudStatusText}" Visibility="{Binding HasCloudStatus, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CloudStatusText}" Foreground="#334155" FontSize="13" Margin="7,0,0,0" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- التنبيهات بعددها: زر قلب يفتح عند الضغط نفسه، ولا يُعاد قلبه بالضغطة التي أغلقت القائمة -->
            <Grid Margin="0,0,8,0">
                <ToggleButton x:Name="AlertsButton" IsChecked="{Binding IsAlertsOpen, Mode=TwoWay}" ClickMode="Press" Cursor="Hand"
                              IsHitTestVisible="{Binding IsOpen, ElementName=AlertsPopup, Converter={StaticResource InverseBool}}" ToolTip="{Binding AlertsText}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="White" CornerRadius="18" Padding="12,6">
                                <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12"/></Border.Effect>
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" FontSize="15" Foreground="{Binding AlertsColor, Converter={StaticResource HexBrush}}" VerticalAlignment="Center"/>
                        <Border Background="#EF4444" CornerRadius="8" MinWidth="18" Height="18" Padding="5,0" Margin="6,0,0,0"
                                Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Alerts.Count}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="لا تنبيهات" Foreground="#64748B" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </StackPanel>
                </ToggleButton>
                    <Popup x:Name="AlertsPopup" IsOpen="{Binding IsAlertsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AlertsButton}" Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" FlowDirection="RightToLeft">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10" Width="420" MaxHeight="520">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="التنبيهات" FontSize="15" FontWeight="Bold" Margin="2,0,0,8"/>
                                <TextBlock DockPanel.Dock="Top" Text="لا تنبيهات الآن ✔" Foreground="#16A34A" Margin="2,0,0,4"
                                           Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <!-- تختفي النافذة الفارغة وحدها بعد 10 ثوانٍ: الشريط يوضح المتبقي -->
                                <ProgressBar DockPanel.Dock="Top" Minimum="0" Maximum="1" Value="{Binding EmptyProgress, Mode=OneWay}" Height="4" Margin="2,2,2,0"
                                             Foreground="#0F766E" Background="#E2E8F0" BorderThickness="0"
                                             Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Alerts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.OpenAlertCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,6" Padding="10,8"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Background="{Binding Color, Converter={StaticResource HexBrush}}" Margin="0,0,10,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="#64748B" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
            </Grid>

            <!-- صورة المستخدم: تغيير الصورة وتسجيل الخروج؛ بقية الخيارات في «إعدادات النظام ← حسابي والمظهر» -->
            <Border Style="{StaticResource Pill}" Padding="4,3,12,3">
                <Menu Background="Transparent">
                    <MenuItem Padding="0" ToolTip="حسابي">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <c:Avatar Photo="{Binding MyPhoto}" DisplayName="{Binding Session.FullName}" Size="32"/>
                                <TextBlock Text="{Binding Session.GlobalUsername}" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="8,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="تغيير صورتي" Command="{Binding ChangeMyPhotoCommand}"/>
                        <MenuItem Header="تسجيل الخروج" Command="{Binding LogoutCommand}" Foreground="#DC2626"/>
                    </MenuItem>
                </Menu>
            </Border>

            <!-- الخروج ظاهر دائمًا -->
            <Button Command="{Binding LogoutCommand}" Cursor="Hand" ToolTip="تسجيل الخروج (تبديل المستخدم)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FEE2E2" CornerRadius="18" Padding="12,6"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FECACA"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14" Foreground="#B91C1C" VerticalAlignment="Center"/>
                    <TextBlock Text="خروج" Foreground="#B91C1C" FontSize="13.5" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ================= الشريط الجانبي ================= -->
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18" Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/app-256.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="نظام ERP" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Session.ProjectName}" Foreground="#94A3B8" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                </StackPanel>
            </StackPanel>

            <!-- البحث السريع و«مفضلتي» -->
            <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8">
                <Button Command="{Binding OpenSearchCommand}" Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="ابحث عن أي شاشة باسمها (Ctrl+K)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource SidebarHoverBrush}"><ContentPresenter/></Border>
                        </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <TextBlock Text="بحث سريع عن شاشة" Foreground="#CBD5E1" FontSize="13.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="★ مفضلتي" Foreground="#FBBF24" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Favorites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenEntryCommand, ElementName=Root}" CommandParameter="{Binding}" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch" ToolTip="{Binding Text}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="6" Padding="8,5" Background="Transparent"><ContentPresenter/></Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="{Binding Color, Converter={StaticResource HexBrush}}">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="11" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Foreground="#E2E8F0" FontSize="13.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="لا توجد وحدات مسموح لك بعرضها. راجع مدير النظام." Foreground="#FCA5A5"
                       Margin="18" TextWrapping="Wrap" Visibility="{Binding HasNoModules, Converter={StaticResource BoolToVisibility}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NavItems}" Margin="10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Command="{Binding DataContext.NavigateCommand, ElementName=Root}" CommandParameter="{Binding}"
                                        Cursor="Hand" Margin="0,2" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="10,9" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{Binding Color, Converter={StaticResource HexBrush}}">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Foreground="#E2E8F0" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- أقسام الوحدة المفتوحة: «الرئيسية» ثم مجموعات ملوّنة، وتفتح مجموعة واحدة فقط بأقسامها
                                     (في «الواجهة الجديدة» تظهر في اللوحة المنبثقة بدلها) -->
                                <StackPanel Visibility="{Binding DataContext.UseNewUi, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Margin="0,0,22,6" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel.Resources>
                                        <Style x:Key="SideLink" TargetType="Button">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="8" Padding="12,8" Margin="0,1" Background="{TemplateBinding Background}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Button Command="{Binding DataContext.CurrentModuleVm.GoHomeCommand, ElementName=Root}" Style="{StaticResource SideLink}">
                                        <Button.Background>
                                            <SolidColorBrush Color="Transparent"/>
                                        </Button.Background>
                                        <TextBlock Text="التحليل" FontSize="14.5" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding DataContext.CurrentModuleVm.Groups, ElementName=Root}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2,0,0">
                                                    <Button Command="{Binding DataContext.CurrentModuleVm.OpenGroupCommand, ElementName=Root}" CommandParameter="{Binding}" Style="{StaticResource SideLink}">
                                                        <Button.Background>
                                                            <SolidColorBrush Color="Transparent"/>
                                                        </Button.Background>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Left" Width="5" CornerRadius="3" Margin="0,0,10,0" Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                                            <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,0" Background="{DynamicResource SidebarChipBrush}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Count}" FontSize="12.5" Foreground="#94A3B8"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Button>
                                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,15,2"
                                                                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button x:Name="Btn" Command="{Binding DataContext.CurrentModuleVm.SelectTabCommand, ElementName=Root}" CommandParameter="{Binding}" Style="{StaticResource SideLink}">
                                                                    <TextBlock x:Name="Lbl" Text="{Binding DisplayTitle}" FontSize="14.5" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                                                </Button>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter TargetName="Btn" Property="Background" Value="{Binding GroupColor, Converter={StaticResource HexBrush}}"/>
                                                                        <Setter TargetName="Lbl" Property="FontWeight" Value="Bold"/>
                                                                        <Setter TargetName="Lbl" Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ================= محتوى الوحدة المختارة ================= -->
        <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding CurrentModule}" Margin="22,18,22,14"/>

        <!-- ================= «الواجهة الجديدة»: لوحة الوحدة تنبثق جانبيًا من زرها — عمودان بلا شريط تمرير ================= -->
        <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsFlyoutOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#40102846" MouseLeftButtonDown="OnFlyoutBackdrop"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="820" Margin="0,64,0,16" Background="{DynamicResource BackgroundBrush}"
                    CornerRadius="0,16,16,0" Padding="16,14,16,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Color="#0B1A33"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="إغلاق (Esc)" Style="{StaticResource RowIconButton}" Tag="#64748B" Command="{Binding CloseFlyoutCommand}"/>
                        <Border DockPanel.Dock="Right" Width="270" CornerRadius="9" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" Margin="0,0,8,0" Padding="10,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox x:Name="FlyoutSearch" Text="{Binding FlyoutFilter, UpdateSourceTrigger=PropertyChanged}" FontSize="13.5" Padding="6,6"
                                         BorderThickness="0" Background="Transparent" ToolTip="ابحث داخل الوحدة">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Escape" Command="{Binding CloseFlyoutCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{Binding SelectedItem.Color, Converter={StaticResource HexBrush}}">
                                <TextBlock Text="{Binding SelectedItem.Glyph}" Style="{StaticResource Icon}" FontSize="17" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedItem.Title}" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- المجموعات على عمودين فتتسع غالبًا؛ وإن زادت (مخازن كثيرة) يظهر شريط تمرير رفيع على اليسار وتلاشٍ سفلي يدل على المزيد -->
                    <Grid>
                    <ScrollViewer x:Name="FlyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnFlyScrollChanged">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Width" Value="9"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                            </Style>
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding FlyoutColumns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                                        <Border Width="5" Height="18" CornerRadius="3" Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DataContext.OpenTileCommand, ElementName=Root}" CommandParameter="{Binding}" Cursor="Hand"
                                                                        HorizontalContentAlignment="Stretch" Margin="0,0,0,7" ToolTip="{Binding Description}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd" CornerRadius="11" Padding="10,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" MinHeight="58">
                                                                                <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                                                    <Setter TargetName="Bd" Property="Background" Value="#F8FBFF"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <DockPanel>
                                                                        <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center"
                                                                                Background="{Binding Color, Converter={StaticResource HexBrush}}">
                                                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="17" Foreground="White"/>
                                                                        </Border>
                                                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Description}" Foreground="#64748B" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border x:Name="FlyFade" Height="36" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#FFFFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= البحث السريع (Ctrl+K) ================= -->
        <Grid x:Name="SearchOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVisibility}}"
              IsVisibleChanged="OnSearchVisibleChanged">
            <Border Background="#66000000" MouseLeftButtonDown="OnSearchBackdrop"/>
            <Border Background="White" CornerRadius="12" Width="560" VerticalAlignment="Top" Margin="0,90,0,0" Padding="14"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="8,6">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding OpenFirstResultCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding CloseSearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="اكتب اسم الشاشة (مثل: فاتورة، رواتب، تقارير) ثم Enter — Esc للإغلاق" Style="{StaticResource Muted}" FontSize="12" Margin="2,6,0,6"/>
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenEntryCommand, ElementName=Root}" CommandParameter="{Binding}" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch" Margin="0,1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="10,7" Background="Transparent"><ContentPresenter/></Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{Binding Color, Converter={StaticResource HexBrush}}">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="White"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding ModuleTitle}" Foreground="#64748B" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
