<Window x:Class="ERP.Desktop.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Shell;assembly=ERP.Presentation"
        xmlns:c="clr-namespace:ERP.Desktop.Views.Controls"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainShellViewModel}"
        x:Name="Root"
        Title="{Binding WindowTitle}"
        FlowDirection="RightToLeft" FontFamily="{StaticResource UiFont}" FontSize="14"
        Width="1400" Height="860" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource BackgroundBrush}">
    <Window.InputBindings>
        <!-- البحث السريع عن أي شاشة -->
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenSearchCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= الشريط الجانبي ================= -->
        <DockPanel Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18" Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/app-256.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="نظام ERP" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Session.ProjectName}" Foreground="#94A3B8" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                </StackPanel>
            </StackPanel>

            <!-- البحث السريع و«مفضلتي» -->
            <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8">
                <Button Command="{Binding OpenSearchCommand}" Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="ابحث عن أي شاشة باسمها (Ctrl+K)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource SidebarHoverBrush}"><ContentPresenter/></Border>
                        </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <TextBlock Text="بحث سريع عن شاشة" Foreground="#CBD5E1" FontSize="13.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="★ مفضلتي" Foreground="#FBBF24" FontSize="13" FontWeight="SemiBold" Margin="4,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Favorites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenEntryCommand, ElementName=Root}" CommandParameter="{Binding}" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch" ToolTip="{Binding Text}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="6" Padding="8,5" Background="Transparent"><ContentPresenter/></Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="{Binding Color, Converter={StaticResource HexBrush}}">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="11" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Foreground="#E2E8F0" FontSize="13.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- المستخدم مرة واحدة: صورته وقائمته (الصورة، المظهر، تبديل المستخدم، إغلاق البرنامج) -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarDeepBrush}" Padding="14,12">
                <DockPanel>
                    <!-- الصورة: الضغط عليها يفتح «تغيير صورتي / إزالة صورتي» -->
                    <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0">
                        <MenuItem Padding="0" ToolTip="حسابي — الصورة والمظهر وتبديل المستخدم">
                            <MenuItem.Header>
                                <c:Avatar Photo="{Binding MyPhoto}" DisplayName="{Binding Session.FullName}" Size="38"/>
                            </MenuItem.Header>
                            <MenuItem Header="تغيير صورتي" Command="{Binding ChangeMyPhotoCommand}"/>
                            <MenuItem Header="إزالة صورتي" Command="{Binding RemoveMyPhotoCommand}" Foreground="#DC2626"
                                      Visibility="{Binding HasOwnPhoto, Converter={StaticResource BoolToVisibility}}"/>
                            <MenuItem Header="المظهر" ItemsSource="{Binding ThemeOptions}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding Name}"/>
                                        <Setter Property="Command" Value="{Binding DataContext.SetThemeCommand, ElementName=Root}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <MenuItem Header="الواجهة الجديدة (لوحة مربعات لكل وحدة)" IsCheckable="False"
                                      IsChecked="{Binding UseNewUi, Mode=OneWay}" Command="{Binding ToggleNewUiCommand}"/>
                            <Separator/>
                            <MenuItem Header="تبديل المستخدم (تسجيل الخروج)" Command="{Binding LogoutCommand}"/>
                            <MenuItem Header="إغلاق البرنامج" Click="OnExitClick" Foreground="#DC2626"/>
                        </MenuItem>
                    </Menu>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Session.GlobalUsername}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.FullName}"/>
                        <TextBlock Text="{Binding Session.RoleName}" Foreground="#94A3B8" FontSize="12.5"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- جرس التنبيهات -->
            <Border DockPanel.Dock="Bottom" Padding="10,6" Background="{DynamicResource SidebarDeepBrush}">
                <Grid>
                    <!-- زر قلب (لا زر عادي): يفتح عند الضغط نفسه، ولا يُعاد قلبه بالضغطة التي أغلقت القائمة -->
                    <ToggleButton x:Name="AlertsButton" IsChecked="{Binding IsAlertsOpen, Mode=TwoWay}" ClickMode="Press"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=AlertsPopup, Converter={StaticResource InverseBool}}"
                                  Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch" Padding="4"
                                  ToolTip="تنبيهات عملك: اضغط لعرضها">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" FontSize="16" Foreground="{Binding AlertsColor, Converter={StaticResource HexBrush}}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AlertsText}" Foreground="#E2E8F0" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="AlertsPopup" IsOpen="{Binding IsAlertsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AlertsButton}" Placement="Top" StaysOpen="False"
                           AllowsTransparency="True" FlowDirection="RightToLeft">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10" Width="420" MaxHeight="520">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="التنبيهات" FontSize="15" FontWeight="Bold" Margin="2,0,0,8"/>
                                <TextBlock DockPanel.Dock="Top" Text="لا تنبيهات الآن ✔" Foreground="#16A34A" Margin="2,0,0,4"
                                           Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Alerts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.OpenAlertCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,6" Padding="10,8"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Background="{Binding Color, Converter={StaticResource HexBrush}}" Margin="0,0,10,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="#64748B" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- مؤشر المزامنة السحابية -->
            <Border DockPanel.Dock="Bottom" Padding="14,8" Background="{DynamicResource SidebarDeepBrush}"
                    Visibility="{Binding HasCloudStatus, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding CloudStatusText}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{Binding CloudStatusColor, Converter={StaticResource HexBrush}}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CloudStatusText}" Foreground="#CBD5E1" FontSize="12.5" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="لا توجد وحدات مسموح لك بعرضها. راجع مدير النظام." Foreground="#FCA5A5"
                       Margin="18" TextWrapping="Wrap" Visibility="{Binding HasNoModules, Converter={StaticResource BoolToVisibility}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NavItems}" Margin="10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Command="{Binding DataContext.NavigateCommand, ElementName=Root}" CommandParameter="{Binding}"
                                        Cursor="Hand" Margin="0,2" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="10,9" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{Binding Color, Converter={StaticResource HexBrush}}">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Foreground="#E2E8F0" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- أقسام الوحدة المفتوحة: «الرئيسية» ثم مجموعات ملوّنة، وتفتح مجموعة واحدة فقط بأقسامها
                                     (في «الواجهة الجديدة» تظهر في اللوحة المنبثقة بدلها) -->
                                <StackPanel Visibility="{Binding DataContext.UseNewUi, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Margin="0,0,22,6" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel.Resources>
                                        <Style x:Key="SideLink" TargetType="Button">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="8" Padding="12,8" Margin="0,1" Background="{TemplateBinding Background}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Button Command="{Binding DataContext.CurrentModuleVm.GoHomeCommand, ElementName=Root}" Style="{StaticResource SideLink}">
                                        <Button.Background>
                                            <SolidColorBrush Color="Transparent"/>
                                        </Button.Background>
                                        <TextBlock Text="الرئيسية" FontSize="14.5" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding DataContext.CurrentModuleVm.Groups, ElementName=Root}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2,0,0">
                                                    <Button Command="{Binding DataContext.CurrentModuleVm.OpenGroupCommand, ElementName=Root}" CommandParameter="{Binding}" Style="{StaticResource SideLink}">
                                                        <Button.Background>
                                                            <SolidColorBrush Color="Transparent"/>
                                                        </Button.Background>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Left" Width="5" CornerRadius="3" Margin="0,0,10,0" Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                                            <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,0" Background="{DynamicResource SidebarChipBrush}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Count}" FontSize="12.5" Foreground="#94A3B8"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Button>
                                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,15,2"
                                                                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button x:Name="Btn" Command="{Binding DataContext.CurrentModuleVm.SelectTabCommand, ElementName=Root}" CommandParameter="{Binding}" Style="{StaticResource SideLink}">
                                                                    <TextBlock x:Name="Lbl" Text="{Binding DisplayTitle}" FontSize="14.5" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                                                </Button>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter TargetName="Btn" Property="Background" Value="{Binding GroupColor, Converter={StaticResource HexBrush}}"/>
                                                                        <Setter TargetName="Lbl" Property="FontWeight" Value="Bold"/>
                                                                        <Setter TargetName="Lbl" Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ================= محتوى الوحدة المختارة ================= -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentModule}" Margin="22,18,22,14"/>

        <!-- ================= «الواجهة الجديدة»: لوحة الوحدة المنبثقة ================= -->
        <Grid Grid.Column="1" Visibility="{Binding IsFlyoutOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#33000000" MouseLeftButtonDown="OnFlyoutBackdrop"/>
            <Border HorizontalAlignment="Left" Width="700" Background="{DynamicResource BackgroundBrush}" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Padding="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="إغلاق" Style="{StaticResource RowIconButton}" Tag="#64748B" Command="{Binding CloseFlyoutCommand}"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="9" Background="{Binding SelectedItem.Color, Converter={StaticResource HexBrush}}">
                                <TextBlock Text="{Binding SelectedItem.Glyph}" Style="{StaticResource Icon}" FontSize="17" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedItem.Title}" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="FlyoutSearch" DockPanel.Dock="Top" Text="{Binding FlyoutFilter, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,5" Margin="0,0,0,10"
                             ToolTip="ابحث داخل الوحدة">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding CloseFlyoutCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FlyoutGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Width="5" Height="18" CornerRadius="3" Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.OpenTileCommand, ElementName=Root}" CommandParameter="{Binding}" Cursor="Hand"
                                                            Width="208" Margin="0,0,8,8" ToolTip="{Binding Description}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" CornerRadius="10" Padding="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"><ContentPresenter/></Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top"
                                                                    Background="{Binding Color, Converter={StaticResource HexBrush}}">
                                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="White"/>
                                                            </Border>
                                                            <StackPanel Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Description}" Foreground="#64748B" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= البحث السريع (Ctrl+K) ================= -->
        <Grid x:Name="SearchOverlay" Grid.ColumnSpan="2" Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVisibility}}"
              IsVisibleChanged="OnSearchVisibleChanged">
            <Border Background="#66000000" MouseLeftButtonDown="OnSearchBackdrop"/>
            <Border Background="White" CornerRadius="12" Width="560" VerticalAlignment="Top" Margin="0,90,0,0" Padding="14"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="8,6">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding OpenFirstResultCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding CloseSearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="اكتب اسم الشاشة (مثل: فاتورة، رواتب، تقارير) ثم Enter — Esc للإغلاق" Style="{StaticResource Muted}" FontSize="12" Margin="2,6,0,6"/>
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenEntryCommand, ElementName=Root}" CommandParameter="{Binding}" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch" Margin="0,1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="10,7" Background="Transparent"><ContentPresenter/></Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{Binding Color, Converter={StaticResource HexBrush}}">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="White"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding ModuleTitle}" Foreground="#64748B" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
