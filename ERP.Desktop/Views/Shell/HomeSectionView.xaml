<UserControl x:Class="ERP.Desktop.Views.Shell.HomeSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Shell;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HomeSectionViewModel}"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ContentControl Content="{Binding Dashboard}" Visibility="{Binding HasDashboard, Converter={StaticResource BoolToVisibility}}"/>
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Left" Content="{Binding ToggleSectionsText}" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleSectionsCommand}"/>
                <TextBlock Text="القوائم الفرعية" Style="{StaticResource SectionTitle}"/>
            </DockPanel>
            <!-- البطاقات مقسّمة بمجموعات القائمة الجانبية: عنوان ملوّن لكل مجموعة ثم بطاقات أقسامها -->
            <ItemsControl ItemsSource="{Binding Groups}" Visibility="{Binding ShowSections, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4,0,6">
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Left" Width="6" Height="24" CornerRadius="3" Margin="0,0,10,0"
                                        Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                <Border DockPanel.Dock="Left" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={StaticResource HexBrushSoft}}">
                                    <TextBlock Text="{Binding Count}" FontSize="12.5" Foreground="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                </Border>
                                <Border/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenSectionCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                Width="280" Height="164" Margin="0,0,14,14" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <!-- بطاقة بلون مجموعتها: شريط جانبي وأيقونة ولمسة خلفية عند المرور، والنص بالألوان الثابتة للقراءة الواضحة -->
                                                    <Grid>
                                                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True"/>
                                                        <Border x:Name="Tint" CornerRadius="10" Opacity="0" IsHitTestVisible="False"
                                                                Background="{Binding GroupColor, Converter={StaticResource HexBrushSoft}}"/>
                                                        <Border x:Name="Ring" CornerRadius="10" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False"
                                                                BorderBrush="{Binding GroupColor, Converter={StaticResource HexBrush}}"/>
                                                        <ContentPresenter/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Tint" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="6" CornerRadius="10,0,0,10" Margin="0"
                                                        Background="{Binding GroupColor, Converter={StaticResource HexBrush}}"/>
                                                <Grid Margin="16,14,16,12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Center"
                                                                   Foreground="{Binding GroupColor, Converter={StaticResource HexBrush}}" ToolTip="فتح"/>
                                                        <Border Width="42" Height="42" CornerRadius="10" HorizontalAlignment="Right"
                                                                Background="{Binding GroupColor, Converter={StaticResource HexBrushSoft}}">
                                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20"
                                                                       Foreground="{Binding GroupColor, Converter={StaticResource HexBrush}}"/>
                                                        </Border>
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="1" Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="16" Margin="0,10,0,4"
                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="13" Foreground="#1F2937" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                                                </Grid>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
