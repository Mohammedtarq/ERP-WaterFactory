<UserControl x:Class="ERP.Desktop.Views.Shell.HubSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Shell;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HubSectionViewModel}">
    <!-- صفحة مدموجة: لكل تبويب لونه (إطاره بلونه، والمختار يمتلئ بلونه) وإطار الصفحة بلون التبويب المختار -->
    <Border BorderThickness="2" CornerRadius="0,0,10,10" Padding="0"
            BorderBrush="{Binding SelectedColor, Converter={StaticResource HexBrush}}">
        <TabControl ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                    BorderThickness="0" Padding="8,8,8,0" Background="Transparent">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid Margin="6,6,0,0" Cursor="Hand">
                                    <Border x:Name="Off" Padding="14,8" CornerRadius="8" BorderThickness="2"
                                            Background="{Binding Color, Converter={StaticResource HexBrushSoft}}"
                                            BorderBrush="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                    <Border x:Name="On" Padding="14,8" CornerRadius="8" Visibility="Collapsed"
                                            Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                    <ContentPresenter x:Name="Cp" Margin="16,10" ContentSource="Header" TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{StaticResource TextBrush}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="On" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Cp" Property="TextElement.Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding Child}" Margin="0,10,0,0"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Border>
</UserControl>
