<UserControl x:Class="ERP.Desktop.Views.Sales.VariantAlertsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Sales;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:VariantAlertsSectionViewModel}">
    <!-- حد يدوي لكل اسم خاص (والأساسي) بالعبوة؛ الاسم بلا حد لا يُتابَع ولا ينبّه -->
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="&#xE72C;" ToolTip="تحديث" Style="{StaticResource RowIconButton}" Tag="#0F766E" Command="{Binding RefreshCommand}"/>
                    <Button Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="حفظ الحدود"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding ShowOptions}" SelectedItem="{Binding Show}" Width="150"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="بحث بالاسم"/>
                    <TextBlock Text="{Binding LowCount, StringFormat='تحت الحد: {0}'}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,4" TextWrapping="Wrap"
                       Text="اكتب الحد بالعبوة (كرتون أو شرنك). الرصيد من مخازن المنتج التام. «يكفي كم يومًا» = الرصيد ÷ معدل الخارج للسوق في آخر 8 أسابيع — للاسترشاد فقط ولا يغيّر الحد."/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding UntrackedText}" Foreground="#B45309" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
            <DataGrid ItemsSource="{Binding VisibleRows}" IsReadOnly="False" CanUserAddRows="False">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLow}" Value="True">
                                <Setter Property="Background" Value="#FEF2F2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم الخاص" Binding="{Binding VariantName}" Width="*" MinWidth="160" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="1.3*" MinWidth="180" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الرصيد" Binding="{Binding BalanceText}" Width="140" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="حد التنبيه ✎" Binding="{Binding MinPacks, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Width="100">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#FFFBEB"/>
                                <Setter Property="ToolTip" Value="اكتب الحد بالعبوة الظاهرة بجانبه؛ اتركه فارغًا لإلغاء المتابعة"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="العبوة" Binding="{Binding PackName}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="يكفي كم يومًا" Binding="{Binding DaysText}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="120" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
