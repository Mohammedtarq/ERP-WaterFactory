<UserControl x:Class="ERP.Desktop.Views.Sales.CustomerDepositsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Sales;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CustomerDepositsSectionViewModel}"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- سند جديد -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="سند تأمين جديد" Style="{StaticResource SectionTitle}"/>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SaveLabel}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="العميل" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name" IsTextSearchEnabled="True"/>
                        <TextBlock Text="نوع السند" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" DisplayMemberPath="Label"/>
                        <TextBlock Text="المبلغ (د.ع)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Amount}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                        <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding Date}"/>
                        <StackPanel Visibility="{Binding IsReceipt, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="عملة الاستلام" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}"/>
                            <StackPanel Visibility="{Binding IsForeign, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="المبلغ المستلم بالعملة الأجنبية" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding CurrencyAmount}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                                <TextBlock Text="المبلغ بالدينار أعلاه هو ما يعادله، ويُسجَّل به الرصيد والقيد." Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="الغرض" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Purpose}"/>
                            <TextBlock Text="الستيكر / الوصفة الخاصة (اختياري)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding Recipe}" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Notes}"/>
                        <Border Background="#F0F9FF" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                            <TextBlock Text="الاستلام يدخل صندوقك والإرجاع يخرج منه، والقيد على حساب «تأمينات العملاء». لا يؤثر على دين العميل."
                                       Foreground="#0369A1" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- سجل العميل -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="&#xE72C;" ToolTip="تحديث" Style="{StaticResource RowIconButton}" Tag="#0F766E" Command="{Binding RefreshCommand}"/>
                    <TextBlock Text="سجل تأمينات العميل" Style="{StaticResource SectionTitle}" Margin="0"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding BalanceText}" FontSize="16" FontWeight="Bold" Foreground="#0369A1" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <Border DockPanel.Dock="Bottom" Background="#FEF2F2" CornerRadius="8" Padding="12,10" Margin="0,10,0,0"
                        Visibility="{Binding IsVoiding, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding VoidTarget.DepositNumber, StringFormat='إلغاء السند {0} (للأدمن) — سبب الإلغاء:'}" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding VoidReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource DangerButton}" Content="تأكيد الإلغاء" Command="{Binding VoidCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="تراجع" Command="{Binding CancelVoidCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding History}" IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="ToolTip" Value="{Binding VoidReason}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding DepositNumber}" Width="125" MinWidth="110"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding DepositDate, StringFormat=yyyy/MM/dd}" Width="90"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding KindText}" Width="95"/>
                        <DataGridTextColumn Header="وارد" Binding="{Binding In, StringFormat=N0}" Width="90"/>
                        <DataGridTextColumn Header="مُرجَع" Binding="{Binding Out, StringFormat=N0}" Width="90"/>
                        <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N0}" Width="95"/>
                        <DataGridTextColumn Header="الغرض / الستيكر" Binding="{Binding Purpose}" Width="*" MinWidth="120"/>
                        <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyText}" Width="90"/>
                        <DataGridCheckBoxColumn Header="ملغى" Binding="{Binding IsVoided, Mode=OneWay}" Width="50"/>
                        <DataGridTemplateColumn Header="" Width="84">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="&#xE749;" ToolTip="طباعة السند" Style="{StaticResource RowIconButton}" Tag="#0F766E"
                                                Command="{Binding DataContext.PrintCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                        <Button Content="&#xE711;" ToolTip="إلغاء السند (للأدمن)" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                                Command="{Binding DataContext.BeginVoidCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- أرصدة كل العملاء -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="12,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="العملاء الذين لديهم تأمينات" Style="{StaticResource SectionTitle}"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding TotalBalances, StringFormat='إجمالي التأمينات القائمة: {0:N0} د.ع'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock DockPanel.Dock="Bottom" Text="انقر عميلًا لفتح سجله" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                <DataGrid ItemsSource="{Binding Balances}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="العميل" Width="*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding CustomerName}" Style="{StaticResource SecondaryButton}" Padding="6,2" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Right" BorderThickness="0" Background="Transparent"
                                            Command="{Binding DataContext.OpenCustomerCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N0}" Width="95"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
