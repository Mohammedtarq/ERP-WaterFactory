<UserControl x:Class="ERP.Desktop.Views.Sales.SalesInvoiceSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Sales;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SalesInvoiceSectionViewModel}"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <!-- ================= شريط الأوامر ================= -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding NewInvoiceCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="فاتورة جديدة"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveDraftCommand}" IsEnabled="{Binding IsEditable}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="حفظ كمسودة"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SuccessButton}" Command="{Binding PostCommand}" IsEnabled="{Binding CanPost}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="ترحيل الفاتورة"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}" ToolTip="معاينة وطباعة الفاتورة (أو حفظها PDF)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="طباعة"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#ECFDF5" CornerRadius="6" Padding="10,5">
                        <TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FlowDirection="LeftToRight"/>
                    </Border>
                    <Border Background="#FEF3C7" CornerRadius="6" Padding="10,5" Margin="8,0,0,0"
                            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="مرحّلة — للعرض فقط" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- ================= رأس الفاتورة ================= -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10" IsEnabled="{Binding IsEditable}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- العميل ونوع تسعيره -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="العميل" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name" IsTextSearchEnabled="True"/>

                        <!-- فلتر الوكيل وعميل الوكيل: اختيار الوكيل = الفاتورة عليه؛ وبالخانة = على أحد عملائه (يظهر اسمه وحده) -->
                        <TextBlock Text="الوكيل (فلتر)" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="إلغاء الوكيل" Style="{StaticResource RowIconButton}" Tag="#64748B"
                                    Command="{Binding ClearAgentCommand}" Margin="4,0,0,0"/>
                            <ComboBox ItemsSource="{Binding Agents}" SelectedItem="{Binding Agent}" DisplayMemberPath="Name" IsTextSearchEnabled="True"/>
                        </DockPanel>
                        <Border Background="#F5F3FF" CornerRadius="6" Padding="8,5" Margin="0,4,0,0"
                                Visibility="{Binding AgentDetails, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding AgentDetails}" TextWrapping="Wrap" Foreground="#6D28D9" FontSize="12"/>
                        </Border>
                        <CheckBox Content="البيع لعميل من عملاء الوكيل" IsChecked="{Binding ForAgentCustomer}" Margin="0,6,0,0"
                                  Visibility="{Binding HasAgent, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Visibility="{Binding ForAgentCustomer, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Text="{Binding AgentCustomerSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" ToolTip="ابحث باسم العميل أو هاتفه"/>
                            <ListBox ItemsSource="{Binding AgentCustomersView}" SelectedItem="{Binding AgentCustomer}" MaxHeight="130" Margin="0,4,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Phone}" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding CustomerDetails}" Foreground="#047857" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding CustomerDetails, Converter={StaticResource NullToCollapsed}}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="نوع البيع" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding SaleModes}" SelectedItem="{Binding SaleModeOption}" DisplayMemberPath="Label" IsEnabled="{Binding IsEditable}"/>
                        <TextBlock Text="المخزن" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name"
                                  IsEnabled="{Binding IsWarehouseSelectable}" ToolTip="{Binding WarehouseHint}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding InvoiceDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="طريقة الدفع" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding PaymentMethod}" DisplayMemberPath="Label"/>
                        <CheckBox Content="تسليم النقد للصندوق فورًا" IsChecked="{Binding HandOverNow}" Margin="0,6,0,0"
                                  ToolTip="بدل بقاء النقد في محفظة المندوب حتى التسليم"
                                  Visibility="{Binding IsVanSale, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                            Background="{Binding PricingTypeColor, Converter={StaticResource HexBrushSoft}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8EC;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                                       Foreground="{Binding PricingTypeColor, Converter={StaticResource HexBrush}}"/>
                            <TextBlock Text="{Binding PricingTypeLabel}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{Binding PricingTypeColor, Converter={StaticResource HexBrush}}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Grid.Column="6" Visibility="{Binding IsPartial, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="المبلغ المدفوع الآن" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding AmountPaidNow, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                    </StackPanel>

                    <!-- الخيارات: ضريبة / رسوم تحميل / بيع مجاني -->
                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="7" Margin="0,10,0,0">
                        <CheckBox Content="ضريبة" IsChecked="{Binding TaxEnabled}" Margin="0,0,6,0" IsEnabled="{Binding IsFreeSale, Converter={StaticResource InverseBool}}"/>
                        <TextBox Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,4,4,0" FlowDirection="LeftToRight"
                                 Visibility="{Binding TaxEnabled, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="%" VerticalAlignment="Center" Margin="0,6,24,0" Visibility="{Binding TaxEnabled, Converter={StaticResource BoolToVisibility}}"/>

                        <CheckBox IsChecked="{Binding IsFreeSale}" Margin="0,0,8,0">
                            <TextBlock Text="بيع مجاني" FontWeight="SemiBold" Foreground="#B45309"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsFreeSale, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="الجهة المستفيدة:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding FreeSaleRecipient, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ================= رسوم مستلزمات التحميل (للوكيل وعملائه فقط) ================= -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10"
                    Visibility="{Binding ShowFees, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="رسوم مستلزمات التحميل" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,4,0,0" IsEnabled="{Binding IsEditable}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="80"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="الاسم" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NewFeeName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="السعر" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewFeePrice, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="العدد" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewFeeQuantity, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/></StackPanel>
                        <Button Grid.Column="6" Content="+ إضافة رسم" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Command="{Binding AddFeeCommand}"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Fees}" CanUserAddRows="False" Margin="0,8,0,0" MaxHeight="150" IsReadOnly="{Binding IsReadOnly}"
                              Visibility="{Binding LoadingEnabled, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الاسم ✎" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="السعر ✎" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridTextColumn Header="العدد ✎" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding Amount, StringFormat=N0, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#xE74D;" ToolTip="حذف الرسم" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                                Command="{Binding DataContext.RemoveFeeCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ================= إضافة سطر ================= -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الصنف" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding ItemsLookup}" SelectedItem="{Binding LineItem}" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName"
                                      ItemTemplate="{StaticResource ItemWithStockTemplate}"/>
                            <ListBox ItemsSource="{Binding PackFilters}" SelectedItem="{Binding PackFilter}" BorderThickness="0" Margin="0,4,0,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ToolTip="تصفية الأصناف حسب صيغة التعبئة">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="وحدة البيع" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding LineLevel}" DisplayMemberPath="LevelName"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="التشغيلة / المتغير" Style="{StaticResource FieldLabel}" ToolTip="تلقائي = الأساسي ومحجوز هذا العميل؛ اختر متغيرًا بالاسم لبيع مناسبة أو اسم مطعم"/>
                            <ComboBox ItemsSource="{Binding BatchOptions}" SelectedItem="{Binding LineBatch}" DisplayMemberPath="Label"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="الكمية" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="السعر المقترح" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LinePrice, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <Button Grid.Column="10" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Command="{Binding AddLineCommand}" IsDefault="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                <TextBlock Text="إضافة سطر"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding LineAvailableText}" Style="{StaticResource Muted}" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding LineBaseUnitsText}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>

            <!-- ================= سطور الفاتورة (الكمية والسعر قابلان للتعديل) ================= -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="{Binding IsReadOnly}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرمز" Binding="{Binding ItemCode}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الوحدة" Binding="{Binding LevelName}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الكمية ✎" Binding="{Binding QuantityInLevel, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="سعر القائمة" Binding="{Binding ListPrice, StringFormat=N0, Mode=OneWay}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="سعر البيع ✎" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="100"
/>
                        <DataGridTextColumn Header="الخصم" Binding="{Binding Discount, StringFormat=N0, Mode=OneWay}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N0, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="التشغيلة" Binding="{Binding BatchLabel}" Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="46">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE74D;" ToolTip="حذف السطر" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                            Command="{Binding DataContext.RemoveLineCommand, ElementName=Root}" CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsEditable, ElementName=Root}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- ================= الملخص ================= -->
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ملخص الفاتورة" Style="{StaticResource SectionTitle}"/>
                    <DockPanel Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PacksTotalText}"/>
                        <TextBlock Text="الكمية" Style="{StaticResource Muted}"/>
                    </DockPanel>
                    <DockPanel Margin="0,4" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalDiscount, StringFormat=N0}" Foreground="#B45309" FontWeight="SemiBold"/>
                        <TextBlock Text="إجمالي الخصم" Style="{StaticResource Muted}"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SubTotal, StringFormat=N0}"/>
                        <TextBlock Text="المجموع" Style="{StaticResource Muted}"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TaxAmount, StringFormat=N0}"/>
                        <TextBlock Text="الضريبة" Style="{StaticResource Muted}"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LoadingAmount, StringFormat=N0}"/>
                        <TextBlock Text="مستلزمات التحميل" Style="{StaticResource Muted}"/>
                    </DockPanel>
                    <Separator Margin="0,8"/>
                    <DockPanel Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="الإجمالي" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PaidNow, StringFormat=N0}" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="المقبوض الآن" Style="{StaticResource Muted}"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AmountDue, StringFormat=N0}" FontWeight="SemiBold"
                                   Foreground="{Binding AmountDue, Converter={StaticResource SignBrush}}"/>
                        <TextBlock Text="المتبقي على العميل" Style="{StaticResource Muted}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                    Visibility="{Binding IsFreeSale, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding FreeSaleNotice}" TextWrapping="Wrap" Foreground="#92400E"/>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Notes}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,12,0,0" Style="{StaticResource Muted}" FontSize="11"
                       Text="الترحيل يخصم الكميات من المخزون (التشغيلة الأقرب انتهاءً أولًا) ويُنشئ القيد المحاسبي عبر العقل المالي في عملية واحدة: إما أن تنجح كلها أو لا يُسجَّل شيء."/>
        </StackPanel>
    </Grid>
</UserControl>
