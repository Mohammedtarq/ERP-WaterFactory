<UserControl x:Class="ERP.Desktop.Views.Sales.SellingPricesSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Sales;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SellingPricesSectionViewModel}"
             xmlns:m="clr-namespace:ERP.Desktop.Mvvm"
             x:Name="Root">
    <UserControl.Resources>
        <m:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="حفظ الأسعار"/>
                        </StackPanel>
                    </Button>
                    <Button Content="&#xE72C;" ToolTip="تحديث" Style="{StaticResource RowIconButton}" Tag="#0F766E" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <WrapPanel>
                    <TextBlock Text="أسعار وكيل:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Agents}" SelectedItem="{Binding Agent}" DisplayMemberPath="Name" Width="220"
                              ToolTip="اختر وكيلًا لعرض أسعاره الخاصة وتعديلها (فارغ = الأسعار العامة فقط)"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="16,0,6,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="بحث باسم المنتج أو الطلب الخاص"/>
                </WrapPanel>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="الأسعار بالعبوة (✎ قابل للتعديل). الطلب الخاص بلا سعر يأخذ سعر المنتج الأساسي، وسعر الوكيل الفارغ يأخذ السعر العام. تسري على الفواتير الجديدة والتطبيق وتسوية المندوب."/>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
            <DataGrid ItemsSource="{Binding VisibleRows}" IsReadOnly="False" CanUserAddRows="False">
                <DataGrid.Resources>
                    <Style x:Key="EditableCell" TargetType="DataGridCell">
                        <Setter Property="Background" Value="#FFFBEB"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="ToolTip" Value="اضغط مرتين للتعديل"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVariant}" Value="True">
                                <Setter Property="Foreground" Value="#7C3AED"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="Background" Value="#FEF9C3"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="المنتج" Binding="{Binding ItemName}" Width="*" MinWidth="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الطلب الخاص" Binding="{Binding VariantText}" Width="170" IsReadOnly="True"/>
                    <DataGridTextColumn Header="العبوة" Binding="{Binding PackText}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="السعر العام للعبوة ✎" Binding="{Binding GeneralPack, StringFormat=N0, TargetNullValue='', UpdateSourceTrigger=LostFocus}"
                                        Width="140" CellStyle="{StaticResource EditableCell}"/>
                    <DataGridTextColumn Header="سعر الوكيل للعبوة ✎" Binding="{Binding AgentPack, StringFormat=N0, TargetNullValue='', UpdateSourceTrigger=LostFocus}"
                                        Width="140" CellStyle="{StaticResource EditableCell}"
                                        Visibility="{Binding Data.HasAgent, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                    <DataGridTextColumn Header="المطبَّق" Binding="{Binding EffectiveText}" Width="190" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="معدَّل" Binding="{Binding IsChanged, Mode=OneWay}" Width="60" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
