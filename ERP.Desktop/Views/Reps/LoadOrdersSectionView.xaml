<UserControl x:Class="ERP.Desktop.Views.Reps.LoadOrdersSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Reps;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LoadOrdersSectionViewModel}"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- طلب جديد (مدير المبيعات) -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="طلب تحميل جديد" Style="{StaticResource SectionTitle}"/>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="سيارة المندوب (كاش فان)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Vans}" SelectedItem="{Binding Van}" DisplayMemberPath="Name"/>
                    <TextBlock Text="{Binding RepName}" Style="{StaticResource Muted}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="من مخزن المنتج التام" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Stores}" SelectedItem="{Binding Store}" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="تاريخ التحميل" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding Date}"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,10,0,6">
                        <Button Content="الحمولة الافتراضية" Style="{StaticResource SecondaryButton}" Command="{Binding UseDefaultCommand}" ToolTip="ملء السطور من الحمولة الافتراضية للمندوب"/>
                        <Button Content="حفظ السطور حمولةً افتراضية" Style="{StaticResource SecondaryButton}" Command="{Binding SaveDefaultCommand}" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="60"/><ColumnDefinition Width="100"/><ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="الصنف" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Text="المتغير" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="الوحدة" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="الكمية" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="القطع" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="5" Text="المتاح في المخزن" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Left" Content="إضافة صنف" Style="{StaticResource SecondaryButton}" Command="{Binding AddLineCommand}"/>
                        <TextBlock Text="{Binding TotalPieces, StringFormat='مجموع القطع: {0:N0}'}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ShortageText}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Notes}"/>
                    <Button Content="إرسال الطلب لأمين المخزن" Style="{StaticResource SuccessButton}" Command="{Binding CreateCommand}" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="60"/><ColumnDefinition Width="100"/><ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding DataContext.Products, ElementName=Root}" SelectedItem="{Binding Product}" DisplayMemberPath="ItemName" IsTextSearchEnabled="True"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Recipes}" SelectedItem="{Binding Recipe}" DisplayMemberPath="Name" Margin="6,0,0,0"
                                              ToolTip="الأساسي = حمولة عامة؛ اسم المطعم = تشغيلاته المحجوزة لتوصيلها له"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" DisplayMemberPath="LevelName" Margin="6,0,0,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Pieces, StringFormat=N0}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding AvailableText}" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsShort}" Value="True">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="6" Content="&#xE74D;" Style="{StaticResource RowIconButton}" Tag="#DC2626" ToolTip="حذف"
                                            Command="{Binding DataContext.RemoveLineCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PendingCount, StringFormat='الطلبات — بانتظار التجهيز: {0}'}" Style="{StaticResource SectionTitle}"/>
                    <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding OrderNumber}" Width="110"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding LoadDate, StringFormat=yyyy/MM/dd}" Width="90"/>
                            <DataGridTextColumn Header="المندوب" Binding="{Binding RepName}" Width="*"/>
                            <DataGridTextColumn Header="القطع" Binding="{Binding RequestedPieces, StringFormat=N0}" Width="70"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="110"/>
                            <DataGridTextColumn Header="مستند الإسناد" Binding="{Binding DocumentNumber}" Width="130"/>
                            <DataGridTextColumn Header="طلبه" Binding="{Binding RequestedBy}" Width="90"/>
                            <DataGridTextColumn Header="جهّزه" Binding="{Binding PreparedBy}" Width="90"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#xE749;" ToolTip="طباعة الطلب" Style="{StaticResource RowIconButton}" Tag="#0F766E"
                                                Command="{Binding DataContext.PrintCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- التجهيز (أمين المخزن) -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="تجهيز الطلب المختار (أمين المخزن)" Style="{StaticResource SectionTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="عدّل «المجهَّز» إن نقص صنف؛ عند التجهيز تخرج الكميات المجهَّزة فقط بمستند إسناد مرقّم."/>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" IsEnabled="{Binding CanPrepare}">
                        <Button Content="تجهيز وإخراج للسيارة" Style="{StaticResource SuccessButton}" Command="{Binding PrepareCommand}"/>
                        <TextBox Text="{Binding CancelReason}" Width="200" Margin="12,0,6,0" ToolTip="سبب الإلغاء"/>
                        <Button Content="إلغاء الطلب" Style="{StaticResource DangerButton}" Command="{Binding CancelOrderCommand}"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding PrepareLines}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المتغير" Binding="{Binding VariantName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding LevelName}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المطلوب" Binding="{Binding Requested, StringFormat=N0}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المتاح" Binding="{Binding AvailableText}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المجهَّز" Binding="{Binding Prepared, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridCheckBoxColumn Header="لا يكفي" Binding="{Binding IsShort, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
