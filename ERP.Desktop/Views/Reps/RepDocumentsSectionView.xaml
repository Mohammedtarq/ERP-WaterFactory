<UserControl x:Class="ERP.Desktop.Views.Reps.RepDocumentsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Reps;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RepDocumentsSectionViewModel}"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- مستند جديد -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="مستند مندوب جديد" Style="{StaticResource SectionTitle}"/>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="نوع المستند" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding DocumentType}" DisplayMemberPath="Label"/>
                    <TextBlock Text="سيارة المندوب (كاش فان)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Vans}" SelectedItem="{Binding Van}" DisplayMemberPath="Name"/>
                    <TextBlock Text="{Binding RepName}" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding StoreLabel}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Stores}" SelectedItem="{Binding Store}" DisplayMemberPath="Name"/>
                    <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding Date}"/>
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="الصنف" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <ComboBox ItemsSource="{Binding ItemsLookup}" SelectedItem="{Binding LineItem}" DisplayMemberPath="ItemName"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding LineLevel}" DisplayMemberPath="LevelName" Width="120"/>
                                <TextBox Text="{Binding LineQuantity}" Width="80" Margin="6,0" FlowDirection="LeftToRight" ToolTip="الكمية"/>
                                <CheckBox Content="تلف ميداني" IsChecked="{Binding LineDamaged}" VerticalAlignment="Center" Margin="6,0"
                                          Visibility="{Binding IsReturn, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="إضافة" Style="{StaticResource SecondaryButton}" Command="{Binding AddLineCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding LinesTotalText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Notes}"/>
                    <Button Content="حفظ وترحيل المستند" Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Lines}" Margin="0,8,0,0" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                        <DataGridTextColumn Header="الوحدة" Binding="{Binding LevelName}" Width="60"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityInLevel, StringFormat=N0}" Width="55"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StateText}" Width="75"/>
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE711;" ToolTip="حذف" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                            Command="{Binding DataContext.RemoveLineCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="سجل المستندات من" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding From}" Width="125"/>
                        <TextBlock Text="إلى" VerticalAlignment="Center" Margin="8,0,6,0"/>
                        <DatePicker SelectedDate="{Binding To}" Width="125"/>
                        <Button Content="عرض" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDocumentsCommand}" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Documents}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding DocumentNumber}" Width="130"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding DocumentType, Converter={StaticResource EnumArabicConverter}}" Width="120"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding DocumentDate, StringFormat=yyyy/MM/dd}" Width="90"/>
                            <DataGridTextColumn Header="المندوب" Binding="{Binding PartyName}" Width="*"/>
                            <DataGridTextColumn Header="القطع" Binding="{Binding TotalPieces, StringFormat=N0}" Width="70"/>
                            <DataGridTextColumn Header="تلف ميداني" Binding="{Binding DamagedPieces, StringFormat=N0}" Width="75"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#xE749;" ToolTip="طباعة المستند" Style="{StaticResource RowIconButton}" Tag="#0F766E"
                                                Command="{Binding DataContext.PrintCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="طباعة جرد السيارة" Style="{StaticResource SecondaryButton}" Command="{Binding PrintStockCommand}"/>
                        <TextBlock Text="{Binding VanTotalPieces, StringFormat='رصيد السيارة الحالي: {0:N0} قطعة'}" Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding VanStock}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="التشغيلة" Binding="{Binding BatchNumber}" Width="110"/>
                            <DataGridTextColumn Header="الصلاحية" Binding="{Binding ExpiryDate, StringFormat=yyyy/MM/dd}" Width="90"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityBaseUnits, StringFormat=N0}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
