<UserControl x:Class="ERP.Desktop.Views.Reps.WalletSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Reps;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:WalletSectionViewModel}"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="المندوب" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                <ComboBox ItemsSource="{Binding Reps}" SelectedItem="{Binding Rep}" DisplayMemberPath="FullName"/>
                <Border Background="#ECFDF5" CornerRadius="8" Padding="14" Margin="0,12,0,4">
                    <StackPanel>
                        <TextBlock Text="رصيد المحفظة (العهدة)" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding Balance, StringFormat='{}{0:N0} د.ع'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding PrintStatementCommand}" Content="طباعة كشف المحفظة" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="الحركة" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" DisplayMemberPath="Label"/>
                <StackPanel Visibility="{Binding NeedsCustomer, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="العميل" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name" IsTextSearchEnabled="True"/>
                    <TextBlock Text="{Binding CustomerDebtText}" FontWeight="SemiBold" Foreground="#B45309" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Visibility="{Binding NeedsDescription, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="وصف المصروف" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ExpenseDescription, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <TextBlock Text="المبلغ (د.ع)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Amount}" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding Date}"/>
                <Button Style="{StaticResource SuccessButton}" Command="{Binding SubmitCommand}" Margin="0,14,0,0" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                        <TextBlock Text="تسجيل الحركة وقيدها"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"
                           Text="النقد من مبيعات الكاش فان يدخل المحفظة تلقائيًا عند ترحيل الفاتورة. التحصيل يُصدر سند قبض على العميل ويظهر في كشف حسابه."/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="&#xE72C;" ToolTip="تحديث" Style="{StaticResource RowIconButton}" Tag="#0F766E" Command="{Binding RefreshCommand}"/>
                    <TextBlock Text="كشف المحفظة" Style="{StaticResource SectionTitle}" Margin="0"/>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Rows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                        <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="وارد" Binding="{Binding AmountIn, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="صادر" Binding="{Binding AmountOut, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="الرصيد" Binding="{Binding RunningBalance, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="القيد" Binding="{Binding EntryNumber}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
