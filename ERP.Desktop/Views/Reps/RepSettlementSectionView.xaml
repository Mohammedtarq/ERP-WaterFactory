<UserControl x:Class="ERP.Desktop.Views.Reps.RepSettlementSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Reps;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RepSettlementSectionViewModel}"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="تسوية نهاية اليوم" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="سيارة المندوب" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Vans}" SelectedItem="{Binding Van}" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="المرتجع السليم إلى" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Stores}" SelectedItem="{Binding Store}" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding Date}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="{Binding RepName, Mode=OneWay}"/>
                        <Run Text=" — في السيارة "/><Run Text="{Binding VanPieces, Mode=OneWay, StringFormat=N0}"/><Run Text=" قطعة، وفي المحفظة "/>
                        <Run Text="{Binding WalletBalance, Mode=OneWay, StringFormat=N0}"/><Run Text=" د.ع"/>
                    </TextBlock>

                    <!-- المرتجع -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="1) المرتجع" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding ItemsLookup}" SelectedItem="{Binding LineItem}" DisplayMemberPath="ItemName" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding LineLevel}" DisplayMemberPath="LevelName" Width="110"/>
                                <TextBox Text="{Binding LineQuantity}" Width="70" Margin="6,0" FlowDirection="LeftToRight" ToolTip="الكمية"/>
                                <CheckBox Content="تالف ميداني" IsChecked="{Binding LineDamaged}" VerticalAlignment="Center" Margin="6,0"/>
                                <Button Content="إضافة" Style="{StaticResource SecondaryButton}" Command="{Binding AddReturnCommand}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Returns}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Left" Content="&#xE74D;" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                                    Command="{Binding DataContext.RemoveReturnCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding ItemName, Mode=OneWay}"/> — <Run Text="{Binding QuantityInLevel, Mode=OneWay, StringFormat=N0}"/>
                                                <Run Text="{Binding LevelName, Mode=OneWay}"/> (<Run Text="{Binding StateText, Mode=OneWay}"/>)
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- المجاني -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="2) مجاني المندوب (لمن ولماذا)" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding ItemsLookup}" SelectedItem="{Binding FreeItem}" DisplayMemberPath="ItemName" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox ItemsSource="{Binding FreeLevelOptions}" SelectedItem="{Binding FreeLevel}" DisplayMemberPath="LevelName" Width="110"/>
                                <TextBox Text="{Binding FreeQuantity}" Width="70" Margin="6,0" FlowDirection="LeftToRight" ToolTip="الكمية"/>
                                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding FreeCustomer}" DisplayMemberPath="Name" Width="200" ToolTip="العميل (اختياري)"/>
                            </StackPanel>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Left" Content="إضافة" Style="{StaticResource SecondaryButton}" Command="{Binding AddFreeCommand}" Margin="6,0,0,0"/>
                                <TextBox Text="{Binding FreeReason}" ToolTip="السبب: هدية افتتاح، تعويض تالف، عينة..."/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding FreeGoods}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Left" Content="&#xE74D;" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                                    Command="{Binding DataContext.RemoveFreeCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                                <Run Text="{Binding ItemName, Mode=OneWay}"/> — <Run Text="{Binding QuantityInLevel, Mode=OneWay, StringFormat=N0}"/>
                                                <Run Text="{Binding LevelName, Mode=OneWay}"/> — <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                                <Run Text="{Binding Reason, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- المصاريف -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="3) المصاريف الميدانية" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBox Text="{Binding ExpenseAmount}" Width="90" FlowDirection="LeftToRight" ToolTip="المبلغ"/>
                                <TextBox Text="{Binding ExpenseDescription}" Width="150" Margin="6,0" ToolTip="الوصف: وقود، تصليح..."/>
                                <ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding ExpenseVehicle}" DisplayMemberPath="VehicleName" Width="120" ToolTip="السيارة"/>
                                <Button Content="إضافة" Style="{StaticResource SecondaryButton}" Command="{Binding AddExpenseCommand}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Expenses}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Left" Content="&#xE74D;" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                                    Command="{Binding DataContext.RemoveExpenseCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Description, Mode=OneWay}"/> — <Run Text="{Binding Amount, Mode=OneWay, StringFormat=N0}"/> د.ع
                                                <Run Text="{Binding VehicleName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- النقد -->
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="4) النقد" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox Content="فوترة ما بقي في السيارة نقدًا على" IsChecked="{Binding InvoiceRemaining}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding InvoiceCustomer}" DisplayMemberPath="Name" Width="200" Margin="6,0,0,0"
                                          IsEnabled="{Binding InvoiceRemaining}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CashHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="النقد المستلم من المندوب" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ReceivedCash, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" FontSize="16"/>
                            <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Notes}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="حفظ التسوية" Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding OverdueCount, StringFormat='مندوبون تأخرت تسويتهم أكثر من يوم: {0}'}" Style="{StaticResource SectionTitle}" Foreground="#DC2626"/>
                    <DataGrid ItemsSource="{Binding Overdue}" IsReadOnly="True" MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المندوب" Binding="{Binding RepName}" Width="*"/>
                            <DataGridTextColumn Header="آخر تسوية" Binding="{Binding LastSettlement, StringFormat=yyyy/MM/dd}" Width="90"/>
                            <DataGridTextColumn Header="أيام" Binding="{Binding DaysOverdue}" Width="50"/>
                            <DataGridTextColumn Header="في السيارة" Binding="{Binding VanPieces, StringFormat=N0}" Width="80"/>
                            <DataGridTextColumn Header="في المحفظة" Binding="{Binding WalletBalance, StringFormat=N0}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="سجل التسويات من" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding From}" Width="125"/>
                        <TextBlock Text="إلى" VerticalAlignment="Center" Margin="8,0,6,0"/>
                        <DatePicker SelectedDate="{Binding To}" Width="125"/>
                        <Button Content="عرض" Style="{StaticResource PrimaryButton}" Command="{Binding LoadHistoryCommand}" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding History}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding SettlementNumber}" Width="110"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding SettlementDate, StringFormat=yyyy/MM/dd}" Width="85"/>
                            <DataGridTextColumn Header="المندوب" Binding="{Binding RepName}" Width="*"/>
                            <DataGridTextColumn Header="مرتجع" Binding="{Binding ReturnedPieces, StringFormat=N0}" Width="60"/>
                            <DataGridTextColumn Header="مجاني" Binding="{Binding FreePieces, StringFormat=N0}" Width="60"/>
                            <DataGridTextColumn Header="مصاريف" Binding="{Binding FieldExpenses, StringFormat=N0}" Width="75"/>
                            <DataGridTextColumn Header="المتوقع" Binding="{Binding ExpectedCash, StringFormat=N0}" Width="90"/>
                            <DataGridTextColumn Header="المستلم" Binding="{Binding ReceivedCash, StringFormat=N0}" Width="90"/>
                            <DataGridTextColumn Header="الفرق" Binding="{Binding Difference, StringFormat=N0}" Width="75"/>
                            <DataGridTextColumn Header="فاتورة الباقي" Binding="{Binding InvoiceNumber}" Width="110"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#xE749;" ToolTip="طباعة التسوية" Style="{StaticResource RowIconButton}" Tag="#0F766E"
                                                Command="{Binding DataContext.PrintCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
