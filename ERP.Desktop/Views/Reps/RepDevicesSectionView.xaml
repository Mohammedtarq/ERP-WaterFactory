<UserControl x:Class="ERP.Desktop.Views.Reps.RepDevicesSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Reps;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RepDevicesSectionViewModel}"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="إيقاف / تفعيل المختار" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleCommand}"/>
                        <Button Content="حذف الجهاز" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="6,0,0,0"/>
                        <Button Content="&#xE72C;" ToolTip="تحديث" Style="{StaticResource RowIconButton}" Tag="#0F766E" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                    <TextBlock Text="هواتف المندوبين" Style="{StaticResource SectionTitle}" Margin="0"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المندوب" Binding="{Binding RepName}" Width="*"/>
                        <DataGridTextColumn Header="الجهاز" Binding="{Binding DeviceName}" Width="*"/>
                        <DataGridTextColumn Header="اسم الدخول" Binding="{Binding LoginName, TargetNullValue=—}" Width="90"/>
                        <DataGridCheckBoxColumn Header="مفعّل" Binding="{Binding IsActive, Mode=OneWay}" Width="60"/>
                        <DataGridTextColumn Header="آخر اتصال" Binding="{Binding LastSeenAt, StringFormat='yyyy/MM/dd HH:mm'}" Width="130"/>
                        <DataGridTextColumn Header="سُجّل في" Binding="{Binding RegisteredAt, StringFormat='yyyy/MM/dd'}" Width="95"/>
                        <DataGridTextColumn Header="بواسطة" Binding="{Binding RegisteredBy}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="تسجيل هاتف جديد" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="المندوب" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Reps}" SelectedItem="{Binding NewRep}" DisplayMemberPath="Label"/>
                    <TextBlock Text="اسم الجهاز" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="تسجيل" Style="{StaticResource PrimaryButton}" Command="{Binding RegisterCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <TextBlock Text="المفتاح السري للجهاز (انسخه إلى الهاتف — لا يُعرض مرة أخرى)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding LastKey, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas" TextWrapping="Wrap"/>
                    <Image Source="{Binding LinkQr, Converter={StaticResource BytesToImage}}" Width="200" Height="200" Margin="0,10,0,0" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="{Binding HasLinkQr, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding LinkHint}" Style="{StaticResource StatusText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="دخول التطبيق (للمندوب المختار)" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="اسم وكلمة مرور من حرف إلى 4 حروف أو أرقام بلا تعقيد. يطلبهما التطبيق عند فتحه." Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Text="اسم الدخول" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Width="120" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                    <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Width="120" FlowDirection="LeftToRight"/>
                        <Button Content="توليد تلقائي" Style="{StaticResource SecondaryButton}" Command="{Binding GenerateLoginCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="حفظ الدخول" Style="{StaticResource SuccessButton}" Command="{Binding SaveLoginCommand}"/>
                        <Button Content="إلغاء الدخول" Style="{StaticResource SecondaryButton}" Command="{Binding ClearLoginCommand}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <!-- بعد الحفظ مباشرة: الاسم وكلمة المرور بخط كبير لتسليمهما للمندوب (لا تُعرض مرة أخرى) -->
                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" BorderThickness="2" BorderBrush="#15803D" Background="#F0FDF4"
                            Visibility="{Binding HasSavedCredentials, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SavedCredentials}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="سلّمها للمندوب الآن — كلمة المرور محفوظة مشفّرة ولا تُعرض مرة أخرى" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="إعدادات تطبيق المندوبين" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Content="السماح بتجاوز حد دين الزبون (مع تنبيه)" IsChecked="{Binding AllowOverLimit}"/>
                    <TextBlock Text="تنبيه بقاء النقد مع المندوب بعد (يوم)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CashAlertDays, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                    <Button Content="حفظ الإعدادات" Style="{StaticResource SuccessButton}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
