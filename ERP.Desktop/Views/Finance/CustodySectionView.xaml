<UserControl x:Class="ERP.Desktop.Views.Finance.CustodySectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Finance;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CustodySectionViewModel}"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= الإجراءات ================= -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" TextWrapping="Wrap"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="صرف عهدة جديدة" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="الموظف" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding IssueEmployee}" DisplayMemberPath="FullName" IsTextSearchEnabled="True"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="المبلغ (د.ع)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding IssueAmount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding IssueDate}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="الغرض" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding IssuePurpose}"/>
                        <TextBlock Text="من صندوق" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding IssueBox}" DisplayMemberPath="Name"/>
                        <Button Content="صرف العهدة" Style="{StaticResource SuccessButton}" Command="{Binding IssueCommand}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding CanManage}"/>

                        <Separator Margin="0,14"/>
                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="العهدة المحددة:"/> <Run Text="{Binding Selected.Number, Mode=OneWay}"/> <Run Text="—"/> <Run Text="{Binding Selected.Employee, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                            <Run Text="الرصيد"/> <Run Text="{Binding Selected.Balance, Mode=OneWay, StringFormat=N0}" FontWeight="Bold"/> <Run Text="د.ع — المبلغ المعتاد"/>
                            <Run Text="{Binding Selected.TargetAmount, Mode=OneWay, StringFormat=N0}"/>
                        </TextBlock>
                        <Button Content="تجديد إلى المبلغ المعتاد" Style="{StaticResource PrimaryButton}" Command="{Binding RenewCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding CanAct}"/>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="تعبئة" Style="{StaticResource SecondaryButton}" Command="{Binding TopUpCommand}" Margin="6,0,0,0" IsEnabled="{Binding CanAct}"/>
                            <TextBox Text="{Binding TopUpAmount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="مبلغ التعبئة"/>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="تسوية" Style="{StaticResource DangerButton}" Command="{Binding SettleCommand}" Margin="6,0,0,0" IsEnabled="{Binding CanAct}"
                                    ToolTip="إعادة كل المتبقي للصندوق وإغلاق العهدة"/>
                            <Button DockPanel.Dock="Right" Content="إعادة" Style="{StaticResource SecondaryButton}" Command="{Binding ReturnCommand}" Margin="6,0,0,0" IsEnabled="{Binding CanAct}"
                                    ToolTip="إعادة مبلغ للصندوق (فارغ = كل المتبقي) وتبقى العهدة فعّالة"/>
                            <TextBox Text="{Binding ReturnAmount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="مبلغ الإعادة (صفر = كل المتبقي)"/>
                        </DockPanel>

                        <Expander Header="مصروف من المكتب على هذه العهدة" Margin="0,12,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding ExpenseCategory}" DisplayMemberPath="Name" IsTextSearchEnabled="True" ToolTip="الباب"/>
                                <TextBlock Text="المبلغ (د.ع)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ExpenseAmount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                                <TextBlock Text="الوصف" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ExpenseDescription}"/>
                                <TextBlock Text="رقم الوصل" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ExpenseReceipt}" FlowDirection="LeftToRight"/>
                                <Button Content="تسجيل المصروف" Style="{StaticResource PrimaryButton}" Command="{Binding AddExpenseCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" IsEnabled="{Binding CanAct}"/>
                            </StackPanel>
                        </Expander>

                        <Separator Margin="0,14"/>
                        <TextBlock Text="تعديل أو إلغاء الحركة المحددة في الكشف" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="المبلغ" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EditAmount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding EditDate}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="الباب (للمصروف)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding EditCategory}" DisplayMemberPath="Name" IsTextSearchEnabled="True"/>
                        <TextBlock Text="الوصف" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EditDescription}"/>
                        <TextBlock Text="رقم الوصل" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EditReceipt}" FlowDirection="LeftToRight"/>
                        <TextBlock Text="السبب (إلزامي للتعديل والإلغاء)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>
                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <Button Content="حفظ التعديل" Style="{StaticResource PrimaryButton}" Command="{Binding SaveEditCommand}" IsEnabled="{Binding CanEditTx}" Margin="0,0,4,0"/>
                            <Button Content="إلغاء الحركة" Style="{StaticResource DangerButton}" Command="{Binding VoidTxCommand}" IsEnabled="{Binding CanAct}" Margin="0,0,4,0"/>
                            <Button Content="إلغاء العهدة" Style="{StaticResource DangerButton}" Command="{Binding VoidCustodyCommand}" IsEnabled="{Binding CanAct}"/>
                        </UniformGrid>

                        <Expander Header="إعدادات التنبيه" Margin="0,12,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="تنبيه العهدة بلا تسوية بعد (يوم)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding AlertDays, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                                <TextBlock Text="تنبيه الرصيد المنخفض دون (%)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding LowPercent, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                                <TextBlock Text="تنبيه مصروف بلا وصل فوق (د.ع)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ReceiptAbove, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                                <Button Content="حفظ الإعدادات" Style="{StaticResource SecondaryButton}" Command="{Binding SaveSettingsCommand}" Margin="0,8,0,0" IsEnabled="{Binding CanManage}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= الجدول والكشف ================= -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <RadioButton GroupName="CustodyFilter" Content="فعّالة" IsChecked="{Binding ShowActive}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <RadioButton GroupName="CustodyFilter" Content="مسوّاة" IsChecked="{Binding ShowSettled}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <RadioButton GroupName="CustodyFilter" Content="الكل" IsChecked="{Binding ShowAll}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding FilterEmployee}" DisplayMemberPath="FullName" Width="170" ToolTip="تصفية بالموظف"/>
                        <TextBlock Text="من" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <DatePicker SelectedDate="{Binding From}" Width="115"/>
                        <TextBlock Text="إلى" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <DatePicker SelectedDate="{Binding To}" Width="115"/>
                        <Button Content="&#xE72C;" ToolTip="تحديث" Style="{StaticResource RowIconButton}" Tag="#2563EB" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
                        <Button Content="طباعة الجدول" Style="{StaticResource SecondaryButton}" Command="{Binding PrintListCommand}" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" RowHeight="NaN" MinRowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="80"/>
                            <DataGridTextColumn Header="الموظف" Binding="{Binding Employee}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="الغرض" Binding="{Binding Purpose}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="تاريخ الصرف" Binding="{Binding IssuedAt, StringFormat=yyyy/MM/dd}" Width="95"/>
                            <DataGridTextColumn Header="المصروف لها" Binding="{Binding Issued, StringFormat=N0}" Width="95"/>
                            <DataGridTextColumn Header="المصروف منها" Binding="{Binding Spent, StringFormat=N0}" Width="95"/>
                            <DataGridTextColumn Header="المُعاد" Binding="{Binding Returned, StringFormat=N0}" Width="80"/>
                            <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N0}" Width="95"/>
                            <DataGridTextColumn Header="العمر (يوم)" Binding="{Binding AgeDays}" Width="80"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Left" Content="طباعة الكشف بالتفاصيل" Style="{StaticResource PrimaryButton}" Command="{Binding PrintCommand}" IsEnabled="{Binding HasSelected}"/>
                        <TextBlock Text="كشف العهدة المحددة" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding TxRows}" SelectedItem="{Binding SelectedTx}" IsReadOnly="True" RowHeight="NaN" MinRowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="90"/>
                            <DataGridTextColumn Header="الحركة" Binding="{Binding KindText}" Width="100"/>
                            <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="الباب" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="الوصل" Binding="{Binding ReceiptNumber}" Width="80"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="95"/>
                            <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N0}" Width="95"/>
                            <DataGridTextColumn Header="ملغاة (السبب)" Binding="{Binding VoidReason}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
