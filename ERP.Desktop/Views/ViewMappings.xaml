    <DataTemplate DataType="{x:Type vmProduction:MachinesSectionViewModel}"><vProduction:MachinesSectionView/></DataTemplate>
    <DataTemplate DataType="{x:Type vmProduction:MachineWipSectionViewModel}"><vProduction:MachineWipSectionView/></DataTemplate>
</ResourceDictionary>
