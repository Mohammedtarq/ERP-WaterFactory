<UserControl x:Class="ERP.Desktop.Views.Production.DailyProductionSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Production;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DailyProductionSectionViewModel}"
             xmlns:m="clr-namespace:ERP.Desktop.Mvvm"
             x:Name="Root">
    <UserControl.Resources>
        <m:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>
    <Grid>
        <!-- السطور بعرض الشاشة كاملًا، وآخر تسجيل واحتياج المواد تحتها -->
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="*" MinHeight="200"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding Date}" Width="130"/>
                    </StackPanel>
                    <TextBlock Text="إنتاج اليوم" Style="{StaticResource SectionTitle}" Margin="0"/>
                </DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RepeatLastCommand}" Margin="0,0,8,4"
                            ToolTip="يملأ السطور بآخر إنتاج مسجّل (المنتج والاسم والوحدة والعدد)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8EE;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="تكرار آخر إنتاج"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="القالب" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="4,0,6,4"/>
                    <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Width="150" Margin="0,0,6,4"/>
                    <Button Content="تطبيق" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyTemplateCommand}" Margin="0,0,12,4"/>
                    <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,6,4" ToolTip="اسم القالب (مثل: أمر الأحد)"/>
                    <Button Content="حفظ السطور كقالب" Style="{StaticResource SecondaryButton}" Command="{Binding SaveTemplateCommand}" Margin="0,0,6,4"/>
                    <Button Content="&#xE74D;" Style="{StaticResource RowIconButton}" Tag="#DC2626" Command="{Binding DeleteTemplateCommand}" ToolTip="حذف القالب المختار" Margin="0,0,0,4"/>
                </WrapPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="{Binding TotalPieces, StringFormat='مجموع القطع: {0:N0}'}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="إضافة منتج" Style="{StaticResource SecondaryButton}" Command="{Binding AddLineCommand}"/>
                        <Button Content="فحص المواد" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewCommand}" Margin="8,0,0,0"
                                ToolTip="احتياج اليوم من كل مادة (ومنها الغطاء والليبل الخاص) مقابل المتاح، قبل التسجيل"/>
                        <Button Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                <TextBlock Text="تسجيل الإنتاج (صرف المواد + الكلفة + التشغيلة)"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                </StackPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="140"/><ColumnDefinition Width="1.6*" MinWidth="130"/><ColumnDefinition Width="1*" MinWidth="80"/>
                        <ColumnDefinition Width="70"/><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/><ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="المنتج" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="1" Text="المتغير (الاسم الخاص)" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="وحدة التعبئة" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="العدد" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="4" Text="اللون" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="5" Text="القطع" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="140"/><ColumnDefinition Width="1.6*" MinWidth="130"/><ColumnDefinition Width="1*" MinWidth="80"/>
                                        <ColumnDefinition Width="70"/><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/><ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding DataContext.Products, ElementName=Root}" SelectedItem="{Binding Product}" DisplayMemberPath="ItemName" IsTextSearchEnabled="True"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Recipes}" SelectedItem="{Binding Recipe}" DisplayMemberPath="Name" Margin="6,0,0,0" ToolTip="الأساسي = الليبل العام؛ الاسم الخاص يستبدل الغطاء والليبل وتُحجز تشغيلته لصاحبه"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" DisplayMemberPath="LevelName" Margin="6,0,0,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding Packs, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" FlowDirection="LeftToRight" HorizontalContentAlignment="Right"/>
                                    <TextBox Grid.Column="4" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Pieces, StringFormat=N0}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="6" Content="&#xE74D;" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                            Command="{Binding DataContext.RemoveLineCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="آخر تسجيل" Style="{StaticResource SectionTitle}"/>
                    <DataGrid ItemsSource="{Binding LastResult}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المنتج" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="المتغير" Binding="{Binding RecipeName, TargetNullValue='أساسي'}" Width="*"/>
                            <DataGridTextColumn Header="التشغيلة" Binding="{Binding BatchNumber}" Width="110"/>
                            <DataGridTextColumn Header="العبوات" Binding="{Binding Packs, StringFormat=N0}" Width="60"/>
                            <DataGridTextColumn Header="القطع" Binding="{Binding Pieces, StringFormat=N0}" Width="60"/>
                            <DataGridTextColumn Header="كلفة القطعة" Binding="{Binding UnitCost, StringFormat=N2}" Width="80"
                                                Visibility="{Binding Data.CanSeeCost, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="احتياج المواد" Style="{StaticResource SectionTitle}"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="المنتج نفسه يتكرر بوحدات وأسماء مختلفة في أمر واحد. كل سطر تشغيلة مستقلة بكلفته؛ وتشغيلة الاسم الخاص محجوزة لصاحبها في البيع والتحميل، والمناسبات تُباع لمن يطلبها بالاسم."/>
                    <DataGrid ItemsSource="{Binding Needs}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShort}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المادة" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="المطلوب" Binding="{Binding Required, StringFormat=N0}" Width="80"/>
                            <DataGridTextColumn Header="المتاح" Binding="{Binding Available, StringFormat=N0}" Width="80"/>
                            <DataGridTextColumn Header="ينقص" Binding="{Binding Short, StringFormat=N0}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
