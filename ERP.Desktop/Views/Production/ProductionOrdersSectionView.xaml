<UserControl x:Class="ERP.Desktop.Views.Production.ProductionOrdersSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ERP.Presentation.ViewModels.Production;assembly=ERP.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ProductionOrdersSectionViewModel}"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewOrderCommand}" IsEnabled="{Binding CanAdd}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                <TextBlock Text="أمر إنتاج جديد"/>
                            </StackPanel>
                        </Button>
                        <Button Content="&#xE72C;" ToolTip="تحديث" Style="{StaticResource RowIconButton}" Tag="#0F766E" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                    <TextBlock Text="المراحل: مسودة ← بدء التشغيل (صرف المواد) ← فحص المختبر ← التعبئة ← مكتمل" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                <DataGrid ItemsSource="{Binding Orders}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الأمر" Binding="{Binding MONumber}" Width="100"/>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding FinishedItemName}" Width="*"/>
                        <DataGridTextColumn Header="الوصفة الخاصة" Binding="{Binding RecipeName}" Width="130"/>
                        <DataGridTextColumn Header="الماكينة" Binding="{Binding MachineName}" Width="100"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityToProduce, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="المعبّأ" Binding="{Binding PackedQuantity, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding OutputBatch}" Width="120"/>
                        <DataGridTextColumn Header="المرحلة" Binding="{Binding StageText}" Width="200"/>
                        <DataGridTemplateColumn Header="" Width="146">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="&#xE70F;" ToolTip="تعديل رقم الدفعة" Style="{StaticResource RowIconButton}" Tag="#8B5CF6"
                                                Command="{Binding DataContext.EditBatchCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                        <Button Content="&#xE768;" ToolTip="بدء التشغيل (صرف المواد)" Style="{StaticResource RowIconButton}" Tag="#10B981"
                                                Command="{Binding DataContext.StartCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                        <Button Content="&#xE73E;" ToolTip="إغلاق بما عُبّئ" Style="{StaticResource RowIconButton}" Tag="#0EA5E9"
                                                Command="{Binding DataContext.CompleteCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                        <Button Content="&#xE711;" ToolTip="إلغاء الأمر" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                                Command="{Binding DataContext.CancelOrderCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE749;" ToolTip="طباعة أمر الإنتاج" Style="{StaticResource RowIconButton}" Tag="#0F766E"
                                            Command="{Binding DataContext.PrintCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE749;" ToolTip="طباعة محضر التعبئة" Style="{StaticResource RowIconButton}" Tag="#8B5CF6"
                                            Command="{Binding DataContext.PrintPackingCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Width="400" Margin="12,0,0,0"
                Visibility="{Binding IsComposing, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="أمر إنتاج جديد" Style="{StaticResource SectionTitle}"/>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="المنتج النهائي (له قائمة مواد)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding FinishedItems}" SelectedItem="{Binding FinishedItem}" DisplayMemberPath="ItemName"/>
                    <TextBlock Text="وصفة مخصصة لعميل (اختياري)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding Recipe}" DisplayMemberPath="Name"/>
                    <TextBlock Text="رقم الدفعة (مولَّد تلقائيًا ويمكن تعديله)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                    <TextBlock Text="الكمية المطلوب إنتاجها (قطعة)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Quantity}" FlowDirection="LeftToRight"/>
                    <TextBlock Text="مخزن المواد الأولية المفضّل (يُصرف من كل مخازن المواد الأولية بترتيب الصلاحية)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding RawWarehouses}" SelectedItem="{Binding RawWarehouse}" DisplayMemberPath="Name"/>
                    <TextBlock Text="الماكينة (تُصرف المواد إلى رصيدها تحت التصنيع)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding Machines}" SelectedItem="{Binding Machine}" DisplayMemberPath="Name"/>
                    <Button Content="إضافة الصنف للأمر (أمر متعدد الأصناف)" Style="{StaticResource SecondaryButton}" Command="{Binding AddLineCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    <ItemsControl ItemsSource="{Binding ComposeLines}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="حذف الصنف من الأمر" Style="{StaticResource RowIconButton}" Tag="#DC2626"
                                            Command="{Binding DataContext.RemoveLineCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                        <Run Text="{Binding ItemName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" — "/><Run Text="{Binding Quantity, Mode=OneWay, StringFormat=N0}"/><Run Text=" قطعة — دفعة "/>
                                        <Run Text="{Binding BatchNumber, Mode=OneWay}"/>
                                        <Run Text="{Binding RecipeName, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="معاينة المواد المطلوبة" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewCommand}" Margin="0,10,0,6" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="إنشاء الأمر" Style="{StaticResource SuccessButton}" Command="{Binding CreateCommand}"/>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Command="{Binding CancelComposeCommand}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Preview}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSufficient}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المادة" Binding="{Binding RawMaterialName}" Width="*"/>
                        <DataGridTextColumn Header="المطلوب" Binding="{Binding Required, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="المتاح" Binding="{Binding Available, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="للأصناف" Binding="{Binding UsedBy}" Width="110"/>
                        <DataGridTextColumn Header="الموقع" Binding="{Binding WhereText}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Width="400" Margin="12,0,0,0"
                Visibility="{Binding IsEditingBatch, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}">
                    <Run Text="تعديل رقم الدفعة — "/><Run Text="{Binding BatchOrder.MONumber, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="الصنف" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding BatchLines}" SelectedItem="{Binding BatchLine}" DisplayMemberPath="FinishedItemName"/>
                    <TextBlock Text="الرقم الحالي" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding BatchLine.OutputBatch}" FontWeight="SemiBold"/>
                    <TextBlock Text="الرقم الجديد (فريد على مستوى النظام)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding NewBatchNumber, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                    <TextBlock Text="سبب التعديل (اختياري)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding BatchReason}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="حفظ الرقم" Style="{StaticResource SuccessButton}" Command="{Binding SaveBatchCommand}"/>
                        <Button Content="إغلاق" Style="{StaticResource SecondaryButton}" Command="{Binding CloseBatchCommand}"/>
                    </StackPanel>
                    <TextBlock Text="سجل التعديلات (الرقم الأصلي محفوظ دائمًا)" Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding BatchHistory}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
