<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>نظام إدارة الأعمال المتكامل</ApplicationTitle>
    <RootNamespace>ERP.Desktop</RootNamespace>
    <!-- يسمح ببناء المشروع (للتحقق) على أنظمة غير Windows؛ التشغيل على Windows فقط -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- أيقونة البرنامج: قطرة ماء بأعمدة متصاعدة (الملف التنفيذي، شريط المهام، وكل النوافذ) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ERP.Data\ERP.Data.csproj" />
    <ProjectReference Include="..\ERP.Presentation\ERP.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
